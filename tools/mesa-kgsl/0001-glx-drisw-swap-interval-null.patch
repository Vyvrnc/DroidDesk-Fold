glx: no NULL call for the swap interval of drisw screens

Zink without kopper (LIBGL_KOPPER_DISABLE) presents through drisw, whose screen
sets no getSwapInterval. glXQueryDrawable(GLX_SWAP_INTERVAL_EXT) then jumped to
address 0: glxgears and glmark2 crashed at start (DroidDesk, Adreno 830).

--- a/src/glx/glx_pbuffer.c	2026-10-31 09:41:20.611968500 +0100
+++ b/src/glx/glx_pbuffer.c	2026-10-31 09:41:20.612945000 +0100
@@ -312,14 +312,18 @@
    }
 
    if (pdraw) {
+      /* drisw screens (zink without kopper) set no getSwapInterval: glxgears and
+       * glmark2 crashed on a NULL call. Without one there is no swap interval. */
       if (attribute == GLX_SWAP_INTERVAL_EXT) {
-         *value = abs(pdraw->psc->driScreen.getSwapInterval(pdraw));
+         *value = pdraw->psc->driScreen.getSwapInterval ?
+            abs(pdraw->psc->driScreen.getSwapInterval(pdraw)) : 0;
          return 1;
       } else if (attribute == GLX_MAX_SWAP_INTERVAL_EXT) {
          *value = pdraw->psc->driScreen.maxSwapInterval;
          return 1;
       } else if (attribute == GLX_LATE_SWAPS_TEAR_EXT) {
-         *value = pdraw->psc->driScreen.getSwapInterval(pdraw) < 0;
+         *value = pdraw->psc->driScreen.getSwapInterval &&
+            pdraw->psc->driScreen.getSwapInterval(pdraw) < 0;
          return 1;
       }
    }
