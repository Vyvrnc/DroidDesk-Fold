#!/bin/sh
# shellcheck disable=SC1111  # Czech quotes („…“) in messages are intended
# droiddesk-wine: Windows x86/x64 apps in DroidDesk's Debian (docs/windows-apps-plan.md).
# v1 backend "fex" = Hangover (aarch64 Wine, ARM64EC): Wine itself and Wine's own programs
# (notepad, winecfg) run native arm64; only x86/x64 app code is emulated:
#   x64 -> FEX as ARM64EC (HODLL64=libarm64ecfex.dll)
#   x86 -> FEX (HODLL=libwow64fex.dll) or Box64 (HODLL=wowbox64.dll), see "x86".
# Installed by wine-install.sh (APK asset) to /usr/local/bin. POSIX sh, LF line endings.
#
# Test hooks: DROIDDESK_WINE_ROOT is prepended to every system path (/etc, /opt, /usr/local),
# DROIDDESK_WINE_BIN / DROIDDESK_WINESERVER_BIN replace wine / wineserver.

ROOT=${DROIDDESK_WINE_ROOT:-}
CONF=$ROOT/etc/droiddesk/wine.conf
OPT=$ROOT/opt/droiddesk-wine
APPDIR=$ROOT/usr/local/share/applications
SELF_BIN=$ROOT/usr/local/bin/droiddesk-wine
GPU_ENV=$ROOT/etc/droiddesk/gpu-env.sh
MENU_SYNC=$ROOT/usr/local/sbin/droiddesk-menu-sync
DPKG_SLIM=$ROOT/etc/dpkg/dpkg.cfg.d/droiddesk-wine-slim
WINE=${DROIDDESK_WINE_BIN:-wine}
WINESERVER=${DROIDDESK_WINESERVER_BIN:-wineserver}
CFG_DIR=${XDG_CONFIG_HOME:-$HOME/.config}/droiddesk-wine
APPS_FILE=$CFG_DIR/apps
BACKENDS="fex"
HANGOVER_PKGS="hangover-wine hangover-libarm64ecfex hangover-libwow64fex hangover-wowbox64"

say() { printf 'droiddesk-wine: %s\n' "$*" >&2; }
die() { say "$*"; exit "${DIE_CODE:-1}"; }
notify() {
    # notify-send TITLE TEXT [icon]; silent without a session bus or libnotify.
    command -v notify-send >/dev/null 2>&1 || return 0
    notify-send -i "${3:-dialog-information}" "$1" "$2" >/dev/null 2>&1 || true
}

usage() {
    cat >&2 <<'EOF'
Použití:
  droiddesk-wine [--backend fex] [--prefix DIR] [--x86 fex|box64] [run] APP.exe|APP.msi|APP.lnk [argumenty]
  droiddesk-wine cfg | explorer | taskmgr | regedit    nastavení / soubory / správce úloh / registr
  droiddesk-wine kill                                  ukončí všechny Windows programy (wineserver -k)
  droiddesk-wine x86 [fex|box64 [APP]]                 emulátor 32bitových (x86) programů:
                                                       globálně, nebo jen pro APP (název .exe/.lnk);
  droiddesk-wine x86 default APP                       zruší výjimku pro APP
  droiddesk-wine com [N] [/tmp/ttyUSBx]                COMn -> port; bez argumentů COM3 -> /tmp/ttyUSB0
                                                       a COM4 -> /tmp/ttyUSB1
  droiddesk-wine menu-sync                             položky nabídky Start do menu plochy
  droiddesk-wine doctor                                diagnostika
  droiddesk-wine uninstall [--purge-prefix]            odinstaluje Wine; prefix (~/.wine-fex) zůstane,
                                                       --purge-prefix ho jen přesune do ~/.wine-fex.removed-DATUM
Ladicí výpisy Wine: DROIDDESK_WINE_DEBUG=1 (nebo hodnota pro WINEDEBUG).
EOF
}

# --- configuration --------------------------------------------------------------------------

conf_get() {
    # conf_get KEY [FILE]: value of KEY=... (last one wins), no shell evaluation.
    [ -f "${2:-$CONF}" ] || return 0
    sed -n "s/^$1=//p" "${2:-$CONF}" | tail -n 1 | tr -d '\r"'"'"
}

conf_set() {
    # conf_set KEY VALUE: replace or append in $CONF.
    mkdir -p "$(dirname "$CONF")" || return 1
    touch "$CONF" || return 1
    if grep -q "^$1=" "$CONF"; then
        sed -i "s|^$1=.*|$1=$2|" "$CONF"
    else
        printf '%s=%s\n' "$1" "$2" >> "$CONF"
    fi
}

valid_emu() { case "$1" in fex|box64) return 0 ;; esac; return 1; }

app_key() {
    # Per-app key: file name of the .exe/.lnk, lower case ("C:\x\PuTTY.EXE" -> putty.exe).
    printf '%s' "$1" | tr '\\' '/' | sed 's|.*/||' | tr 'A-Z' 'a-z'
}

pick_x86() {
    # Effective x86 emulator for APP: --x86 > DROIDDESK_WINE_X86 > apps file > wine.conf > fex.
    if [ -n "$OPT_X86" ]; then echo "$OPT_X86"; return; fi
    if valid_emu "${DROIDDESK_WINE_X86:-}"; then echo "$DROIDDESK_WINE_X86"; return; fi
    if [ -n "${1:-}" ] && [ -f "$APPS_FILE" ]; then
        v=$(conf_get "$(app_key "$1" | sed 's/[].[*^$/\\]/\\&/g')" "$APPS_FILE")
        if valid_emu "$v"; then echo "$v"; return; fi
    fi
    v=$(conf_get X86_EMU)
    if valid_emu "$v"; then echo "$v"; else echo fex; fi
}

detect_lang() {
    # Android's locale: wine.conf LOCALE (written by the installer from the app), else
    # Android's getprop when proot lets it run, else en_US.
    l=${DROIDDESK_WINE_LANG:-$(conf_get LOCALE)}
    if [ -z "$l" ]; then
        for gp in getprop /system/bin/getprop; do
            command -v "$gp" >/dev/null 2>&1 || continue
            l=$(timeout 3 "$gp" persist.sys.locale 2>/dev/null)
            [ -n "$l" ] || l=$(timeout 3 "$gp" ro.product.locale 2>/dev/null)
            [ -n "$l" ] && break
        done
    fi
    case "$l" in
        cs|cs[-_]*) echo cs_CZ.UTF-8 ;;
        *) echo en_US.UTF-8 ;;
    esac
}

setup_env() {
    # setup_env [APP]: everything Wine needs, before any wine call.
    export WINEPREFIX
    if [ -n "${DROIDDESK_WINE_DEBUG:-}" ]; then
        case "$DROIDDESK_WINE_DEBUG" in
            1|yes|on) unset WINEDEBUG ;;
            *) export WINEDEBUG="$DROIDDESK_WINE_DEBUG" ;;
        esac
    else
        export WINEDEBUG=-all
    fi
    LANG=$(detect_lang)
    export LANG LC_ALL="$LANG"
    # We write menu entries ourselves (menu-sync); winemenubuilder's would not reach XFCE.
    export WINEDLLOVERRIDES="winemenubuilder.exe=d${WINEDLLOVERRIDES:+;$WINEDLLOVERRIDES}"
    # shellcheck disable=SC1090
    [ -f "$GPU_ENV" ] && [ ! -f "$ROOT/etc/droiddesk/gpu-off" ] && . "$GPU_ENV"
    X86_EMU=$(pick_x86 "${1:-}")
    export HODLL64=libarm64ecfex.dll
    if [ "$X86_EMU" = box64 ]; then export HODLL=wowbox64.dll; else export HODLL=libwow64fex.dll; fi
}

installed() {
    command -v "$WINE" >/dev/null 2>&1 ||
        die "Wine není nainstalované. Nainstaluj „Windows aplikace“ v katalogu aplikací DroidDesku."
}

# --- paths ----------------------------------------------------------------------------------

zpath() {
    # Debian path -> Windows path on Z: (msiexec and cmd take "/x" for an option).
    printf 'Z:%s' "$1" | tr '/' '\\'
}

termux_hint() {
    DIE_CODE=2 die "Soubor „$1“ je na straně Androidu (Termux), kam Debian a Wine nevidí. Zkopíruj ho do Stažených (/storage/emulated/0/Download) nebo do domovské složky Debianu a otevři ho odtamtud."
}

resolve_path() {
    # Sets RESOLVED. Accepts Debian paths (incl. /storage and /tmp, shared with Android) and
    # Windows paths (C:\...); maps /sdcard and paths into the Debian rootfs as seen from
    # Termux; refuses other Termux-side paths (Thunar runs on the Termux side).
    p=$1
    case "$p" in
        [A-Za-z]:\\*|[A-Za-z]:/*) RESOLVED=$p; return 0 ;;
        file://*) p=${p#file://}; p=${p#localhost} ;;
    esac
    case "$p" in
        /sdcard) p=/storage/emulated/0 ;;
        /sdcard/*) p=/storage/emulated/0/${p#/sdcard/} ;;
        */proot-distro/installed-rootfs/debian/*) p=/${p#*/proot-distro/installed-rootfs/debian/} ;;
        */proot-distro/containers/debian/rootfs/*) p=/${p#*/proot-distro/containers/debian/rootfs/} ;;
    esac
    case "$p" in
        /data|/data/*) termux_hint "$1" ;;
    esac
    [ -e "$p" ] || DIE_CODE=2 die "Soubor „$1“ neexistuje."
    RESOLVED=$(realpath -- "$p") || DIE_CODE=2 die "Soubor „$1“ nelze otevřít."
    case "$RESOLVED" in
        /data|/data/*) termux_hint "$1" ;;
    esac
}

# --- prefix ---------------------------------------------------------------------------------

link_com() {
    # link_com N TARGET [noreg]: COMn -> TARGET (dosdevices symlink + Wine's Ports key).
    case "$2" in
        /tmp/*|/dev/*) ;;
        *) DIE_CODE=2 die "Port „$2“ nepodporuji, použij /tmp/ttyUSB0 (z okna USB) nebo zařízení v /dev." ;;
    esac
    mkdir -p "$WINEPREFIX/dosdevices"
    ln -sfn "$2" "$WINEPREFIX/dosdevices/com$1"
    # Wine's mountmgr manages comN links; the Ports key makes the mapping stick.
    if [ "${3:-}" != noreg ]; then
        "$WINE" reg add 'HKLM\Software\Wine\Ports' /v "COM$1" /t REG_SZ /d "$2" /f >/dev/null 2>&1 ||
            say "COM$1: zápis do registru se nepovedl (odkaz v dosdevices platí)."
    fi
    if [ -e "$2" ]; then
        say "COM$1 -> $2"
    else
        say "COM$1 -> $2 (zatím neexistuje: připoj adaptér v okně USB jako sériový port, nebo droiddesk-serial open)"
    fi
}

check_com() {
    # Before an app starts: warn about COM links whose /tmp port is not open.
    missing=
    for l in "$WINEPREFIX"/dosdevices/com*; do
        [ -L "$l" ] || continue
        t=$(readlink "$l")
        case "$t" in /tmp/*) ;; *) continue ;; esac
        [ -e "$t" ] && continue
        n=$(basename "$l" | tr 'a-z' 'A-Z')
        missing="${missing:+$missing, }$n -> $t"
    done
    if [ -n "$missing" ]; then
        say "Sériový port není otevřený: $missing. Připoj adaptér v okně USB, pokud ho aplikace potřebuje."
        notify "Windows aplikace" "Sériový port není otevřený ($missing). Pokud ho aplikace potřebuje, připoj adaptér v okně USB." dialog-warning
    fi
}

ensure_mono() {
    # wine-mono (.NET Framework 4.x replacement) from our pinned MSI; reinstalled when it changes.
    msi=$(ls "$OPT"/mono/wine-mono-*-arm64.msi 2>/dev/null | tail -n 1)
    [ -n "$msi" ] || return 0
    want=$(basename "$msi")
    [ "$(cat "$WINEPREFIX/.droiddesk-mono" 2>/dev/null)" = "$want" ] && return 0
    say "Instaluji Wine Mono ($want) pro .NET aplikace…"
    notify "Windows aplikace" "Instaluji Wine Mono pro .NET aplikace…"
    if "$WINE" msiexec /i "$(zpath "$msi")" /qn; then
        echo "$want" > "$WINEPREFIX/.droiddesk-mono"
    else
        say "Wine Mono se nenainstalovalo; .NET aplikace nepoběží (zkus to znovu: droiddesk-wine doctor)."
    fi
}

ensure_prefix() {
    if [ ! -f "$WINEPREFIX/system.reg" ]; then
        say "Připravuji prostředí Windows v $WINEPREFIX (první spuštění, asi 1–2 minuty)…"
        notify "Windows aplikace" "Připravuji prostředí Windows (první spuštění, asi 1–2 minuty)…"
        mkdir -p "$WINEPREFIX"
        # mscoree/mshtml off: no Mono/Gecko download dialog (Hangover 11.16's is broken anyway);
        # Mono comes from our MSI below.
        if ! WINEDLLOVERRIDES="$WINEDLLOVERRIDES;mscoree=d;mshtml=d" "$WINE" wineboot -i; then
            notify "Windows aplikace" "Prostředí Windows se nepodařilo připravit (droiddesk-wine doctor)." dialog-error
            die "wineboot -i selhal."
        fi
        "$WINESERVER" -w >/dev/null 2>&1
        [ -d /storage/emulated/0 ] && [ ! -e "$WINEPREFIX/dosdevices/d:" ] &&
            ln -s /storage/emulated/0 "$WINEPREFIX/dosdevices/d:"
        link_com 3 /tmp/ttyUSB0 >/dev/null 2>&1
        link_com 4 /tmp/ttyUSB1 >/dev/null 2>&1
        notify "Windows aplikace" "Prostředí Windows je připravené."
    fi
    ensure_mono
}

after_run() {
    # Installers often leave children behind; sync the menu once all of them ended.
    "$WINESERVER" -w >/dev/null 2>&1
    menu_sync quiet
}

# --- commands -------------------------------------------------------------------------------

run_app() {
    resolve_path "$1"
    shift
    installed
    setup_env "$RESOLVED"
    ensure_prefix
    check_com
    case "$RESOLVED" in
        /*) cd "$(dirname "$RESOLVED")" 2>/dev/null || true ;;
    esac
    case "$(printf '%s' "$RESOLVED" | tr 'A-Z' 'a-z')" in
        *.exe|*.com) "$WINE" "$RESOLVED" "$@" ;;
        *.msi) "$WINE" msiexec /i "$(zpath "$RESOLVED")" "$@" ;;
        *.bat|*.cmd) "$WINE" cmd /c "$(zpath "$RESOLVED")" "$@" ;;
        [a-z]:*) "$WINE" start /wait "$RESOLVED" "$@" ;;
        *) "$WINE" start /wait /unix "$RESOLVED" "$@" ;;
    esac
    rc=$?
    after_run
    return $rc
}

run_builtin() {
    installed
    setup_env "$1.exe"
    ensure_prefix
    "$WINE" "$@"
    rc=$?
    after_run
    return $rc
}

cmd_x86() {
    case "${1:-}" in
        "")
            v=$(conf_get X86_EMU)
            valid_emu "$v" || v=fex
            echo "Výchozí emulátor x86 (32bitových programů): $v"
            if [ -s "$APPS_FILE" ]; then
                echo "Výjimky ($APPS_FILE):"
                sed 's/^/  /' "$APPS_FILE"
            fi
            echo "64bitové programy běží vždy přes FEX (ARM64EC)."
            ;;
        default|reset)
            [ -n "${2:-}" ] || DIE_CODE=2 die "Chybí název aplikace: droiddesk-wine x86 default APP.exe"
            k=$(app_key "$2")
            [ -f "$APPS_FILE" ] && sed -i "/^$(printf '%s' "$k" | sed 's/[].[*^$/\\]/\\&/g')=/d" "$APPS_FILE"
            echo "$k: výchozí emulátor x86"
            ;;
        fex|box64)
            if [ -n "${2:-}" ]; then
                k=$(app_key "$2")
                mkdir -p "$CFG_DIR"
                touch "$APPS_FILE"
                sed -i "/^$(printf '%s' "$k" | sed 's/[].[*^$/\\]/\\&/g')=/d" "$APPS_FILE"
                printf '%s=%s\n' "$k" "$1" >> "$APPS_FILE"
                echo "$k: emulátor x86 = $1"
            else
                conf_set X86_EMU "$1" || die "Nelze zapsat $CONF."
                echo "Výchozí emulátor x86 = $1 (platí od dalšího spuštění aplikace)"
            fi
            ;;
        *) DIE_CODE=2 die "Neznámý emulátor „$1“, zvol fex nebo box64." ;;
    esac
}

cmd_com() {
    installed
    setup_env
    ensure_prefix
    if [ -z "${1:-}" ]; then
        link_com 3 /tmp/ttyUSB0
        link_com 4 /tmp/ttyUSB1
        return 0
    fi
    case "$1" in
        *[!0-9]*|0) DIE_CODE=2 die "Číslo portu musí být 1–256 (např. droiddesk-wine com 3 /tmp/ttyUSB0)." ;;
    esac
    [ "$1" -le 256 ] || DIE_CODE=2 die "Číslo portu musí být 1–256."
    link_com "$1" "${2:-/tmp/ttyUSB0}"
}

desktop_quote() {
    # A path as one quoted argument of a .desktop Exec line; refuses characters that would
    # need the spec's double escaping.
    case "$1" in
        *'"'*|*'`'*|*'$'*|*'\'*) return 1 ;;
    esac
    printf '"%s"' "$(printf '%s' "$1" | sed 's/%/%%/g')"
}

menu_sync() {
    # Start Menu .lnk files of the prefix -> $APPDIR/wine-<backend>-*.desktop, then the
    # Debian -> XFCE mirror (droiddesk-menu-sync).
    mkdir -p "$APPDIR" 2>/dev/null || { [ "${1:-}" = quiet ] || say "Nelze zapsat $APPDIR."; return 0; }
    written=$(mktemp) || return 0
    lnks=$(mktemp) || { rm -f "$written"; return 0; }
    for root in "$WINEPREFIX/drive_c/ProgramData/Microsoft/Windows/Start Menu" \
        "$WINEPREFIX"/drive_c/users/*/AppData/Roaming/Microsoft/Windows/"Start Menu"; do
        [ -d "$root" ] && find "$root" -type f -iname '*.lnk' >> "$lnks"
    done
    while IFS= read -r lnk; do
        name=$(basename "$lnk")
        name=${name%.*}
        case "$(printf '%s' "$name" | tr 'A-Z' 'a-z')" in
            *uninstall*|*odinstal*|*deinstal*) continue ;;
        esac
        q=$(desktop_quote "$lnk") || continue
        id=$(printf '%s' "$name" | tr -c 'A-Za-z0-9._-' '_' | cut -c1-40)
        sum=$(printf '%s' "$lnk" | cksum | cut -d' ' -f1)
        f="$APPDIR/wine-$BACKEND-$id-$sum.desktop"
        {
            echo "[Desktop Entry]"
            echo "Type=Application"
            echo "Name=$name"
            echo "Comment=Windows aplikace (Wine)"
            echo "Exec=droiddesk-wine --backend $BACKEND $q"
            echo "Icon=application-x-ms-dos-executable"
            echo "Categories=Utility;"
            echo "Terminal=false"
            echo "X-DroidDesk-Wine-Lnk=$lnk"
        } > "$f.tmp" && mv -f "$f.tmp" "$f"
        basename "$f" >> "$written"
    done < "$lnks"
    removed=0
    for f in "$APPDIR"/wine-"$BACKEND"-*.desktop; do
        [ -f "$f" ] || continue
        grep -qxF "$(basename "$f")" "$written" && continue
        rm -f "$f"
        removed=$((removed + 1))
    done
    n=$(wc -l < "$written" | tr -d ' ')
    rm -f "$written" "$lnks"
    [ -x "$MENU_SYNC" ] && "$MENU_SYNC" >/dev/null 2>&1
    [ "${1:-}" = quiet ] || echo "Nabídka Start: položek $n, odebráno $removed."
}

cmd_doctor() {
    echo "== droiddesk-wine doctor =="
    echo "Velikost stránky: $(getconf PAGESIZE 2>/dev/null || echo ?) (Wine potřebuje 4096)"
    echo "Architektura: $(uname -m), Debian $(cat "$ROOT/etc/debian_version" 2>/dev/null || echo ?)"
    echo "Backend: $BACKEND (Hangover, aarch64 Wine + ARM64EC)"
    if command -v "$WINE" >/dev/null 2>&1; then
        echo "Wine: $("$WINE" --version 2>/dev/null || echo 'nespustitelné')"
    else
        echo "Wine: nenainstalované"
    fi
    echo "Balíčky Hangover:"
    # shellcheck disable=SC2086
    dpkg-query -W -f '  ${Package} ${Version} ${db:Status-Abbrev}\n' $HANGOVER_PKGS 2>/dev/null || true
    for d in hangover mono dxvk; do
        [ -d "$OPT/$d" ] && echo "$OPT/$d: $(cat "$OPT/$d/.droiddesk-version" 2>/dev/null || echo 'bez verze')"
    done
    [ -f "$DPKG_SLIM" ] && echo "Úsporná instalace (--slim): ano"
    echo "Konfigurace $CONF:"
    if [ -f "$CONF" ]; then sed 's/^/  /' "$CONF"; else echo "  (chybí)"; fi
    setup_env
    echo "Emulátor x86: $X86_EMU (HODLL=$HODLL), x64: FEX (HODLL64=$HODLL64)"
    [ -s "$APPS_FILE" ] && { echo "Výjimky pro aplikace:"; sed 's/^/  /' "$APPS_FILE"; }
    echo "Jazyk: LANG=$LANG"
    echo "Prefix: $WINEPREFIX"
    if [ -f "$WINEPREFIX/system.reg" ]; then
        echo "  připravený, Wine Mono: $(cat "$WINEPREFIX/.droiddesk-mono" 2>/dev/null || echo 'ne')"
        for l in "$WINEPREFIX"/dosdevices/com* "$WINEPREFIX"/dosdevices/d:; do
            [ -L "$l" ] || continue
            t=$(readlink "$l")
            if [ -e "$t" ]; then s=ok; else s="neexistuje"; fi
            echo "  $(basename "$l") -> $t ($s)"
        done
    else
        echo "  zatím nevytvořený (vytvoří se při prvním spuštění)"
    fi
    echo "DISPLAY=${DISPLAY:-(nenastaveno)}  PULSE_SERVER=${PULSE_SERVER:-(nenastaveno)}"
    echo "GPU: $( [ -f "$GPU_ENV" ] && [ ! -f "$ROOT/etc/droiddesk/gpu-off" ] && echo "gpu-env.sh (GALLIUM_DRIVER=${GALLIUM_DRIVER:-?})" || echo "software (llvmpipe)")"
    ports=$(ls /tmp/ttyUSB* 2>/dev/null)
    echo "Sériové porty: ${ports:-žádné /tmp/ttyUSB*}"
    echo "Volné místo: $(df -Pm / 2>/dev/null | awk 'NR==2{print $4 " MB"}')"
    if pgrep -x wineserver >/dev/null 2>&1; then echo "wineserver: běží"; else echo "wineserver: neběží"; fi
}

cmd_uninstall() {
    purge=
    for a in "$@"; do
        case "$a" in
            --purge-prefix) purge=1 ;;
            *) DIE_CODE=2 die "Neznámá volba „$a“." ;;
        esac
    done
    command -v "$WINESERVER" >/dev/null 2>&1 && WINEPREFIX=$WINEPREFIX "$WINESERVER" -k >/dev/null 2>&1
    pkgs=
    for p in $HANGOVER_PKGS; do
        dpkg-query -W -f '${db:Status-Abbrev}' "$p" 2>/dev/null | grep -q '^ii' && pkgs="$pkgs $p"
    done
    if [ -n "$pkgs" ]; then
        say "Odebírám balíčky:$pkgs"
        # shellcheck disable=SC2086
        DEBIAN_FRONTEND=noninteractive apt-get purge -y $pkgs || die "apt-get purge selhal."
    fi
    rm -rf "$OPT"
    rm -f "$DPKG_SLIM" "$APPDIR"/droiddesk-wine.desktop "$APPDIR"/droiddesk-winecfg.desktop \
        "$APPDIR"/droiddesk-wine-explorer.desktop
    for b in $BACKENDS; do rm -f "$APPDIR"/wine-"$b"-*.desktop; done
    for m in "$ROOT/etc/xdg/mimeapps.list" "$(conf_get MIMEAPPS_TERMUX)"; do
        [ -n "$m" ] && [ -f "$m" ] && sed -i -e '/=debian-droiddesk-wine\.desktop;$/d' -e '/=droiddesk-wine\.desktop;$/d' "$m"
    done
    rm -f "$CONF"
    [ -x "$MENU_SYNC" ] && "$MENU_SYNC" >/dev/null 2>&1
    for b in $BACKENDS; do
        p="$HOME/.wine-$b"
        [ -d "$p" ] || continue
        if [ -n "$purge" ]; then
            dest="$p.removed-$(date +%Y%m%d-%H%M%S)"
            mv "$p" "$dest" && say "Prefix přesunut do $dest (smaž ho ručně, až ho nebudeš potřebovat)."
        else
            say "Prefix $p (nainstalované programy, licence, nastavení) zůstal. Smazat ho můžeš ručně."
        fi
    done
    rm -f "$SELF_BIN"
    say "Windows aplikace odinstalovány."
}

# --- main -----------------------------------------------------------------------------------

BACKEND=${DROIDDESK_WINE_BACKEND:-fex}
PREFIX_OPT=
OPT_X86=
while [ $# -gt 0 ]; do
    case "$1" in
        --backend) [ $# -ge 2 ] || DIE_CODE=2 die "--backend potřebuje hodnotu."; BACKEND=$2; shift 2 ;;
        --backend=*) BACKEND=${1#*=}; shift ;;
        --prefix) [ $# -ge 2 ] || DIE_CODE=2 die "--prefix potřebuje hodnotu."; PREFIX_OPT=$2; shift 2 ;;
        --prefix=*) PREFIX_OPT=${1#*=}; shift ;;
        --x86) [ $# -ge 2 ] || DIE_CODE=2 die "--x86 potřebuje hodnotu."; OPT_X86=$2; shift 2 ;;
        --x86=*) OPT_X86=${1#*=}; shift ;;
        -h|--help) usage; exit 0 ;;
        --) shift; break ;;
        -*) usage; DIE_CODE=2 die "Neznámá volba „$1“." ;;
        *) break ;;
    esac
done
case " $BACKENDS " in
    *" $BACKEND "*) ;;
    *) DIE_CODE=2 die "Backend „$BACKEND“ není v této verzi k dispozici (jen: $BACKENDS)." ;;
esac
if [ -n "$OPT_X86" ] && ! valid_emu "$OPT_X86"; then
    DIE_CODE=2 die "Neznámý emulátor „$OPT_X86“, zvol fex nebo box64."
fi
WINEPREFIX=${PREFIX_OPT:-$HOME/.wine-$BACKEND}

if [ $# -eq 0 ]; then
    # From the menu ("Spustit ve Windows" without a file) open Wine's file browser.
    if [ -t 1 ]; then usage; exit 2; fi
    run_builtin explorer
    exit $?
fi
cmd=$1
shift
case "$cmd" in
    run) [ $# -ge 1 ] || { usage; exit 2; }; run_app "$@" ;;
    cfg|winecfg) run_builtin winecfg ;;
    explorer) run_builtin explorer "$@" ;;
    taskmgr) run_builtin taskmgr ;;
    regedit) run_builtin regedit ;;
    kill) WINEPREFIX=$WINEPREFIX "$WINESERVER" -k ;;
    x86) cmd_x86 "$@" ;;
    com) cmd_com "$@" ;;
    menu-sync) menu_sync ;;
    doctor) cmd_doctor ;;
    uninstall) cmd_uninstall "$@" ;;
    help) usage ;;
    *) run_app "$cmd" "$@" ;;
esac
