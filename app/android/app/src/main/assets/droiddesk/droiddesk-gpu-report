#!/usr/bin/env python3
"""DroidDesk GPU report: what the GPU does on this device, as one Markdown file to send us.

Runs from the DroidDesk terminal (Termux side) or from Debian (claude-debian, debian-run).
It only reads state and starts test programs; it changes no settings.

  droiddesk-gpu-report             environment, OpenGL, Vulkan, WebGL in every browser found
  droiddesk-gpu-report --bench     plus a short glmark2 run on each side
  droiddesk-gpu-report --no-browsers
  droiddesk-gpu-report --browser firefox   only browsers whose name contains this text

Report: ~/droiddesk-gpu-report-<time>.md (the path is printed at the end).
"""
import argparse
import datetime
import glob
import http.server
import json
import os
import shlex
import shutil
import signal
import socketserver
import subprocess
import sys
import tempfile
import threading
import time

VERSION = 3
APP_DATA = "/data/user/0/com.orailnoor.droiddesk/files"
# In Debian the session keeps Termux's prefix as DD_SAVED_PREFIX.
PREFIX_CANDIDATES = [os.environ.get("DROIDDESK_PREFIX", ""), os.environ.get("PREFIX", ""),
                     os.environ.get("DD_SAVED_PREFIX", ""), APP_DATA + "/usr",
                     "/data/data/com.orailnoor.droiddesk/files/usr"]


def find_prefix():
    for p in PREFIX_CANDIDATES:
        if p and os.path.isfile(os.path.join(p, "bin", "bash")) and "com.orailnoor.droiddesk" in p:
            return p
    for p in PREFIX_CANDIDATES:
        if p and os.path.isfile(os.path.join(p, "bin", "bash")) and not p.startswith("/usr"):
            return p
    return ""


PREFIX = find_prefix()
IN_TERMUX = bool(os.environ.get("PREFIX")) and os.environ.get("PREFIX") == PREFIX
DISPLAY = os.environ.get("DISPLAY") or ":0"


DESKTOP_PROCESSES = ("xfce4-panel", "xfce4-session", "xfwm4", "xfdesktop")


def desktop_environ():
    """Environment of a running Termux desktop process: the one the desktop's own programs get
    (X socket dir, Mesa/Vulkan driver paths, LD_PRELOAD hooks). None without a running desktop."""
    if not PREFIX:
        return None
    for pid in sorted((d for d in os.listdir("/proc") if d.isdigit()), key=int):
        try:
            with open("/proc/%s/cmdline" % pid, "rb") as f:
                argv0 = f.read().split(b"\0")[0].decode("utf-8", "replace")
            if os.path.basename(argv0) not in DESKTOP_PROCESSES:
                continue
            with open("/proc/%s/environ" % pid, "rb") as f:
                env = dict(item.decode("utf-8", "replace").split("=", 1)
                           for item in f.read().split(b"\0") if b"=" in item)
        except (OSError, ValueError):
            continue
        # Only a Termux-side process (Debian's environment would be the wrong one).
        if env.get("PREFIX") and os.path.isdir(os.path.join(env["PREFIX"], "bin")):
            return env
    return None


def fallback_environ():
    files = os.path.dirname(PREFIX)
    return {"PREFIX": PREFIX, "PATH": "%s/bin:/system/bin" % PREFIX, "LD_LIBRARY_PATH": "%s/lib" % PREFIX,
            "TMPDIR": files + "/tmp", "HOME": files + "/home", "DISPLAY": DISPLAY,
            "VK_ICD_FILENAMES": "%s/share/vulkan/icd.d/freedreno_icd.aarch64.json" % PREFIX}


TERMUX_ENV = None
TERMUX_ENV_SOURCE = ""


def termux_env():
    global TERMUX_ENV, TERMUX_ENV_SOURCE
    if TERMUX_ENV is None:
        env = desktop_environ()
        TERMUX_ENV_SOURCE = "running desktop" if env else "fallback (no Termux desktop process found)"
        TERMUX_ENV = env or fallback_environ()
        TERMUX_ENV.setdefault("DISPLAY", DISPLAY)
    return TERMUX_ENV


def termux_argv(cmd):
    """argv that runs a shell command on the Termux side."""
    if IN_TERMUX:
        return ["bash", "-lc", cmd]
    if not PREFIX:
        return None
    env = ["%s=%s" % kv for kv in sorted(termux_env().items())]
    # /system/bin/env: Termux's own env needs Termux's libraries before LD_LIBRARY_PATH is set.
    return ["/system/bin/env", "-i"] + env + [PREFIX + "/bin/bash", "-lc", cmd]


def termux_tmp():
    return os.environ.get("TMPDIR", "/tmp") if IN_TERMUX else termux_env().get("TMPDIR", os.path.dirname(PREFIX) + "/tmp")


def debian_argv(cmd):
    """argv that runs a shell command in Debian (native, with the session's GPU setup)."""
    if not IN_TERMUX and os.path.isfile("/etc/debian_version"):
        return ["bash", "-lc", cmd]
    if PREFIX and os.path.isfile(PREFIX + "/bin/debian-run"):
        return [PREFIX + "/bin/debian-run", "bash", "-lc", cmd]
    return None


SIDES = {"termux": termux_argv, "debian": debian_argv}


def run(side, cmd, timeout=60):
    argv = SIDES[side](cmd)
    if argv is None:
        return None, "(%s side not available)" % side
    env = dict(os.environ, DISPLAY=DISPLAY)
    try:
        p = subprocess.run(argv, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=timeout,
                           env=env, stdin=subprocess.DEVNULL)
        return p.returncode, p.stdout.decode("utf-8", "replace")
    except subprocess.TimeoutExpired as e:
        out = (e.stdout or b"").decode("utf-8", "replace")
        return "timeout", out + "\n(timed out after %ss)" % timeout
    except OSError as e:
        return "error", str(e)


def has(side, name):
    rc, out = run(side, "command -v %s" % shlex.quote(name), timeout=20)
    return rc == 0 and out.strip() != ""


ERROR_WORDS = ("error", "unable", "failed", "cannot", "can't", "could not", "not found", "no such",
               "bad interpreter", "denied", "segmentation", "abort")


def why(rc, out):
    """Return code plus the first line of the output that looks like the cause."""
    line = next((l.strip() for l in out.splitlines() if any(w in l.lower() for w in ERROR_WORDS)), "")
    return "rc %s%s" % (rc, (": " + line[:160]) if line else "")


def tail(text, lines=40):
    rows = text.rstrip().splitlines()
    return "\n".join(rows[-lines:])


