class Results:
    def __init__(self):
        self.lock = threading.Lock()
        self.data = {}

    def put(self, key, value):
        with self.lock:
            self.data[key] = value

    def get(self, key):
        with self.lock:
            return self.data.get(key)


RESULTS = Results()


class Handler(http.server.BaseHTTPRequestHandler):
    def log_message(self, *args):
        pass

    def do_GET(self):
        body = PAGE.encode()
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_POST(self):
        raw = self.rfile.read(int(self.headers.get("Content-Length") or 0))
        run_id = self.path.split("?")[0].strip("/").split("/")
        try:
            value = json.loads(raw.decode("utf-8", "replace") or "{}")
        except ValueError:
            value = {"raw": raw[:500].decode("utf-8", "replace")}
        # Path: /<run>/loaded or /<run>/result (the page posts relative to its URL).
        if len(run_id) == 2:
            RESULTS.put(tuple(run_id), value)
        self.send_response(204)
        self.end_headers()


def start_server():
    srv = socketserver.ThreadingTCPServer(("127.0.0.1", 0), Handler)
    srv.daemon_threads = True
    threading.Thread(target=srv.serve_forever, daemon=True).start()
    return srv


# Browsers: (label, side, command name, how to launch with a fresh profile).
BROWSERS = [
    ("Firefox (Termux)", "termux", "firefox", "firefox -no-remote -profile {profile} {url}"),
    ("Chromium (Termux)", "termux", "chromium-browser",
     "chromium-browser --user-data-dir={profile} --no-first-run --no-default-browser-check {url}"),
    ("Firefox ESR (Debian)", "debian", "firefox-esr", "firefox-esr -no-remote -profile {profile} {url}"),
    ("Firefox (Debian)", "debian", "firefox", "firefox -no-remote -profile {profile} {url}"),
    ("Chromium (Debian)", "debian", "chromium",
     "chromium --user-data-dir={profile} --no-first-run --no-default-browser-check {url}"),
    ("Brave (Debian)", "debian", "brave-browser",
     "brave-browser --user-data-dir={profile} --no-first-run --no-default-browser-check {url}"),
    ("Google Chrome (Debian)", "debian", "google-chrome",
     "google-chrome --user-data-dir={profile} --no-first-run --no-default-browser-check {url}"),
]


def browser_test(label, side, launch, port, timeout=75):
    run_id = "r%d" % int(time.time() * 1000)
    url = "http://127.0.0.1:%d/%s/" % (port, run_id)
    profile = "/tmp/droiddesk-gpu-report-%s" % run_id
    if side == "termux":
        profile = termux_tmp() + "/droiddesk-gpu-report-" + run_id
    cmd = "mkdir -p %s; exec %s" % (shlex.quote(profile), launch.format(profile=shlex.quote(profile), url=url))
    argv = SIDES[side](cmd)
    log = tempfile.TemporaryFile()
    started = time.time()
    proc = subprocess.Popen(argv, stdout=log, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL,
                            start_new_session=True, env=dict(os.environ, DISPLAY=DISPLAY))
    loaded = result = None
    exit_code = None
    while time.time() - started < timeout:
        loaded = loaded or RESULTS.get((run_id, "loaded"))
        result = RESULTS.get((run_id, "result"))
        if result is not None:
            break
        if proc.poll() is not None:
            exit_code = proc.returncode
            time.sleep(2)
            result = RESULTS.get((run_id, "result"))
            break
        time.sleep(0.5)
    elapsed = round(time.time() - started, 1)
    try:
        os.killpg(proc.pid, signal.SIGTERM)
        time.sleep(2)
        os.killpg(proc.pid, signal.SIGKILL)
    except (ProcessLookupError, PermissionError):
        pass
    try:
        proc.wait(timeout=5)
    except subprocess.TimeoutExpired:
        pass
    log.seek(0)
    output = log.read().decode("utf-8", "replace")
    run(side, "rm -rf %s" % shlex.quote(profile), timeout=30)
    if result is not None:
        verdict = result.get("result", "?")
    elif exit_code is not None:
        verdict = "browser-exited-%s" % exit_code + ("-after-load" if loaded else "-before-load")
    else:
        verdict = "timeout-after-load" if loaded else "timeout-no-load"
    if result is None:
        cause = why(exit_code, output).split(": ", 1)
        if len(cause) == 2:
            verdict += " (%s)" % cause[1].replace("|", "/")
    return {"label": label, "verdict": verdict, "seconds": elapsed, "loaded": bool(loaded),
            "result": result, "log_tail": tail(output, 30)}


# ── Report ──

def section(out, title, body, lang=""):
    out.append("\n### %s\n\n```%s\n%s\n```\n" % (title, lang, body.rstrip() or "(empty)"))


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--bench", action="store_true", help="also run a short glmark2 on each side")
    ap.add_argument("--no-browsers", action="store_true")
    ap.add_argument("--browser", default="", help="only browsers whose label contains this text")
    ap.add_argument("--out", default="")
    args = ap.parse_args()

    stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M")
    out_path = args.out or os.path.join(os.path.expanduser("~"), "droiddesk-gpu-report-%s.md" % stamp)
    summary, raw = [], []
    say = lambda s: print(s, flush=True)

    say("DroidDesk GPU report v%d, writing %s" % (VERSION, out_path))
    say("Running from: %s, Termux prefix: %s" % ("Termux" if IN_TERMUX else "Debian", PREFIX or "not found"))
    if not IN_TERMUX and PREFIX:
        termux_env()
        say("Termux environment: " + TERMUX_ENV_SOURCE)
        summary.append("- Run from Debian; Termux-side environment: " + TERMUX_ENV_SOURCE)

    # Environment
    rc, props = run("termux", "for p in ro.product.manufacturer ro.product.model ro.soc.manufacturer ro.soc.model "
                    "ro.hardware.egl ro.hardware.vulkan ro.build.version.release; do echo \"$p=$(getprop $p)\"; done",
                    timeout=20)
    rc2, state = run("termux",
                     "ls -l /dev/kgsl-3d0 /dev/dri 2>&1; echo; "
                     "for f in $PREFIX/etc/droiddesk/native-gpu-virgl; do [ -e $f ] && echo \"termux marker: $f\"; done; "
                     "ls -l $PREFIX/tmp/.virgl_test 2>&1; true", timeout=20)
    rc3, dstate = run("debian",
                      "cat /etc/debian_version; ls /etc/droiddesk/ 2>&1; "
                      "for f in gpu-off gpu-off-reason gpu-virgl gpu-selftest; do "
                      "[ -e /etc/droiddesk/$f ] && echo \"$f: $(cat /etc/droiddesk/$f)\"; done; "
                      "cat /opt/mesa-kgsl/VERSION /opt/mesa-kgsl/version 2>/dev/null; true", timeout=60)
    section(raw, "Android properties", props)
    section(raw, "GPU devices and Termux markers", state)
    section(raw, "Debian GPU state (/etc/droiddesk)", dstate)
    model = dict(l.split("=", 1) for l in props.splitlines() if "=" in l)
    summary.append("- Device: %s %s, SoC %s %s, Android %s" % (
        model.get("ro.product.manufacturer", "?"), model.get("ro.product.model", "?"),
        model.get("ro.soc.manufacturer", "?"), model.get("ro.soc.model", "?"),
        model.get("ro.build.version.release", "?")))
    rc, _ = run("termux", "test -e /dev/kgsl-3d0", timeout=20)
    summary.append("- Adreno (/dev/kgsl-3d0): %s" % ("yes" if rc == 0 else "no"))

    # OpenGL and Vulkan on both sides
    for side in ("termux", "debian"):
        if SIDES[side]("true") is None:
            summary.append("- %s: not available" % side)
            continue
        if has(side, "glxinfo"):
            rc, out = run(side, "glxinfo -B", timeout=60)
            section(raw, "glxinfo -B (%s)" % side, out)
            renderer = next((l.split(":", 1)[1].strip() for l in out.splitlines()
                             if "OpenGL renderer string" in l), "failed (%s)" % why(rc, out))
            version = next((l.split(":", 1)[1].strip() for l in out.splitlines()
                            if l.strip().startswith("OpenGL version string")
                            or l.strip().startswith("OpenGL core profile version string")), "")
            summary.append("- OpenGL (%s): %s %s" % (side, renderer, ("/ " + version) if version else ""))
        else:
            summary.append("- OpenGL (%s): glxinfo missing (%s)" % (
                side, "pkg install mesa-demos" if side == "termux" else "apt install mesa-utils"))
        # glxinfo never maps its window; Debian's Mesa 25 on virgl then fails with BadMatch
        # (X_GetImage) although programs with a visible window work. glxgears draws in one.
        if has(side, "glxgears"):
            rc, out = run(side, "timeout 7 glxgears", timeout=30)
            section(raw, "glxgears 5 s (%s)" % side, tail(out, 6))
            fps = [l.strip() for l in out.splitlines() if "FPS" in l]
            summary.append("- glxgears (%s): %s" % (side, fps[0] if fps else "no frames (%s)" % why(rc, out)))
        if has(side, "vulkaninfo"):
            rc, out = run(side, "vulkaninfo --summary", timeout=60)
            section(raw, "vulkaninfo --summary (%s)" % side, tail(out, 60))
            devs = [l.split("=", 1)[1].strip() for l in out.splitlines() if l.strip().startswith("deviceName")]
            summary.append("- Vulkan (%s): %s" % (side, ", ".join(devs) or "failed (%s)" % why(rc, out)))
        else:
            summary.append("- Vulkan (%s): vulkaninfo missing (%s)" % (
                side, "pkg install vulkan-tools" if side == "termux" else "apt install vulkan-tools"))
        if args.bench:
            for name in ("glmark2", "glmark2-es2"):
                if has(side, name):
                    say("glmark2 on %s (up to 3 min)..." % side)
                    rc, out = run(side, "%s -b build -b texture -b shading:shading=phong -b terrain "
                                  "-b refract --size 1280x720" % name, timeout=240)
                    section(raw, "%s (%s)" % (name, side), tail(out, 30))
                    score = next((l for l in out.splitlines() if "Score" in l), "no score (%s)" % why(rc, out))
                    summary.append("- %s (%s): %s" % (name, side, score.strip()))
                    break
            else:
                summary.append("- glmark2 (%s): not installed" % side)

    # Browsers
    browser_rows = []
    if not args.no_browsers:
        srv = start_server()
        port = srv.server_address[1]
        for label, side, binary, launch in BROWSERS:
            if args.browser and args.browser.lower() not in label.lower():
                continue
            if SIDES[side]("true") is None or not has(side, binary):
                continue
            say("WebGL test: %s (up to 75 s, a browser window opens)..." % label)
            r = browser_test(label, side, launch, port)
            browser_rows.append(r)
            say("  -> %s" % r["verdict"])
            section(raw, "WebGL: %s" % label, json.dumps(r["result"], indent=1) if r["result"] else "(no result)", "json")
            section(raw, "Browser output: %s (last lines)" % label, r["log_tail"])
        srv.shutdown()
        if not browser_rows:
            summary.append("- Browsers: none found")

    # Write
    lines = ["# DroidDesk GPU report", "",
             "Generated %s by droiddesk-gpu-report v%d (from %s)." % (
                 datetime.datetime.now().isoformat(timespec="seconds"), VERSION, "Termux" if IN_TERMUX else "Debian"),
             "", "## Summary", ""] + summary
    if browser_rows:
        lines += ["", "## WebGL in browsers", "",
                  "| Browser | Result | FPS | WebGL2 | Renderer | S3TC | Time |", "|---|---|---|---|---|---|---|"]
        for r in browser_rows:
            res = r["result"] or {}
            inf = res.get("webgl1Info") or {}
            lines.append("| %s | %s | %s | %s | %s | %s | %ss |" % (
                r["label"], r["verdict"], res.get("fps", ""), "yes" if res.get("webgl2") else ("no" if res else ""),
                (inf.get("renderer") or "").replace("|", "/"), "yes" if inf.get("s3tc") else ("no" if inf else ""),
                r["seconds"]))
    lines += ["", "## Manual checks (fill in)", "",
              "| Check | Result | Note |", "|---|---|---|",
              "| Desktop smooth (windows, scrolling) | | |",
              "| Electron app (VS Code, Obsidian, ...) | | |",
              "| 3D app (OrcaSlicer, FreeCAD, Blender) | | |",
              "| Video (YouTube 1080p in a browser) | | |",
              "", "## Raw output", ""] + raw
    with open(out_path, "w", encoding="utf-8") as f:
        f.write("\n".join(lines) + "\n")
    say("")
    say("\n".join(summary))
    say("")
    say("Report: %s" % out_path)


if __name__ == "__main__":
    sys.exit(main())
