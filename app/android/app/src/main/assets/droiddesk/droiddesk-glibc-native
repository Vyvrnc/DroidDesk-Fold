#!/usr/bin/env bash
# Opt-in Debian glibc launcher. Run this from Termux, outside proot.
set -euo pipefail

PREFIX=${PREFIX:-$(cd "$(dirname "$0")/.." && pwd)}
R=$PREFIX/var/lib/proot-distro/containers/debian/rootfs
N=$PREFIX/opt/glibc-native
PLIB=$N/plib
SHARE=$N/share
T=${PREFIX%/usr}/tmp
LIBPATH=$PLIB:$N/lib:$R/lib/aarch64-linux-gnu:$R/usr/lib/aarch64-linux-gnu
fail() { printf 'Chyba: %s\n' "$*" >&2; exit 1; }
need_python() { command -v python3 >/dev/null || fail 'Chybí Termux Python. Spusťte: pkg install python'; }

# Resolve Debian absolute symlinks inside its root, without following them on Android.
resolve() {
    python3 - "$R" "$1" <<'PY'
import os, sys
root, path = sys.argv[1:]
for _ in range(40):
    parts = os.path.normpath(path).split('/')
    current = '/'
    for i, part in enumerate(parts):
        if not part:
            continue
        current = os.path.join(current, part)
        if os.path.islink(current):
            target = os.readlink(current)
            if target.startswith('/'):
                target = root + target if current.startswith(root + '/') and not target.startswith(root + '/') else target
            else:
                target = os.path.join(os.path.dirname(current), target)
            path = os.path.join(target, *parts[i + 1:])
            break
    else:
        print(current)
        break
else:
    sys.exit('Příliš mnoho symbolických odkazů: ' + path)
PY
}

setup() {
    need_python
    [[ -f $SHARE/pathhook.so ]] || fail 'Chybí pathhook.so. Sestavte jej pomocí tools/glibc-native/build.sh a znovu sestavte aplikaci.'
    [[ -f $SHARE/patch-glibc.py ]] || fail 'Chybí patch-glibc.py v instalaci aplikace.'
    local ld libc uv signature stage
    ld=$(resolve "$R/usr/lib/aarch64-linux-gnu/ld-linux-aarch64.so.1")
    libc=$(resolve "$R/usr/lib/aarch64-linux-gnu/libc.so.6")
    uv=$(resolve "$R/usr/lib/aarch64-linux-gnu/libuv.so.1")
    [[ -f $ld && -f $libc ]] || fail 'Chybí Debian glibc. Nejdříve nainstalujte Debian v aplikaci.'
    mkdir -p "$PLIB" "$N/bin" "$N/lib"
    signature=$({ sha256sum "$ld" "$libc" "$SHARE/patch-glibc.py" "$SHARE/pathhook.so"; [[ ! -f $uv ]] || sha256sum "$uv"; } | sha256sum)
    if [[ -f $N/stamp && $(cat "$N/stamp") == "$signature" && -f $PLIB/ld.so && -f $PLIB/libc.so.6 && -f $N/lib/pathhook.so ]] && { [[ ! -f $uv ]] || [[ -f $PLIB/libuv.so.1 ]]; }; then
        setup_data
        printf 'Nativní glibc je aktuální.\n'
        return
    fi
    stage=$(mktemp -d "$N/.setup.XXXXXX")
    # Publish only after every required pattern matched; leave the previous setup usable.
    if ! python3 "$SHARE/patch-glibc.py" ld "$ld" "$stage/ld.so" ||
       ! python3 "$SHARE/patch-glibc.py" libc "$libc" "$stage/libc.so.6" ||
       { [[ -f $uv ]] && ! python3 "$SHARE/patch-glibc.py" libuv "$uv" "$stage/libuv.so.1"; }; then
        rm -rf "$stage"
        fail 'Úprava glibc selhala. V Debianu se změnily očekávané instrukce; instalace nebyla aktualizována.'
    fi
    cp "$SHARE/pathhook.so" "$stage/pathhook.so"
    chmod 755 "$stage/pathhook.so"
    mv -f "$stage/ld.so" "$stage/libc.so.6" "$PLIB/"
    if [[ -f $stage/libuv.so.1 ]]; then mv -f "$stage/libuv.so.1" "$PLIB/"; else rm -f "$PLIB/libuv.so.1"; fi
    mv -f "$stage/pathhook.so" "$N/lib/pathhook.so"
    printf '%s\n' "$signature" > "$stage/stamp"
    mv -f "$stage/stamp" "$N/stamp"
    rmdir "$stage"
    setup_data
    printf 'Nativní glibc je připravena.\n'
}

setup_data() {
    local dir link target locale input stage
    mkdir -p "$N/locale"
    # ld.so opens libraries internally, so interposition cannot fix these links.
    for dir in "$R/lib/aarch64-linux-gnu" "$R/usr/lib/aarch64-linux-gnu"; do
        [[ -d $dir ]] || continue
        while IFS= read -r -d '' link; do
            target=$(readlink "$link")
            [[ $target == /* ]] || continue
            target=$(resolve "$link")
            [[ ! -f $target ]] || ln -sfn "$target" "$N/lib/$(basename "$link")"
        done < <(find "$dir" -maxdepth 1 -type l -print0)
    done
    # LOCPATH bypasses locale-archive; localedef must publish directory locales.
    for locale in C.UTF-8 "${LANG:-C.UTF-8}" cs_CZ.UTF-8 en_US.UTF-8; do
        [[ $locale != C && $locale != POSIX && $locale != */* ]] || continue
        [[ ! -d $N/locale/$locale ]] || continue
        input=${locale%%.*}; input=${input%%@*}
        [[ -f $R/usr/share/i18n/locales/$input && -f $R/usr/share/i18n/charmaps/UTF-8.gz && -x $R/usr/bin/localedef ]] || continue
        stage=$(mktemp -d "$N/locale/.build.XXXXXX")
        if (run_native /usr/bin/env "I18NPATH=$R/usr/share/i18n" /usr/bin/localedef --no-archive -i "$input" -f UTF-8 "$stage/$locale"); then
            mv -T "$stage/$locale" "$N/locale/$locale"
        else
            printf 'Varování: Nepodařilo se vytvořit locale %s.\n' "$locale" >&2
        fi
        rm -rf "$stage"
    done
    if [[ -d $R/usr/lib/locale/C.utf8 && ! -e $N/locale/C.UTF-8 ]]; then
        ln -s "$R/usr/lib/locale/C.utf8" "$N/locale/C.UTF-8"
    fi
}

native_locale() {
    local locale=${LANG:-C.UTF-8} normalized
    normalized=${locale//UTF-8/utf8}
    if [[ $locale == C || $locale == POSIX || ( $locale != */* && ( -d $N/locale/$locale || -d $N/locale/$normalized ) ) ]]; then
        printf '%s\n' "$locale"
    else
        printf 'C.UTF-8\n'
    fi
}

ready() {
    [[ -f $N/stamp && -x $PLIB/ld.so && -f $N/lib/pathhook.so ]] || fail 'Nejdříve spusťte: droiddesk-glibc-native setup'
}

source_path() {
    local path=$1 dir
    case $path in
        /root|/root/*|/home|/home/*|/usr/*|/etc/*|/var/*|/opt/*|/lib/*|/bin/*|/sbin/*) path=$R$path ;;
        /*) ;;
        */*) path=$PWD/$path ;;
        *)
            for dir in /usr/local/bin /usr/bin /bin; do
                path=$(resolve "$R$dir/$1")
                if [[ -f $path && -x $path ]]; then printf '%s\n' "$path"; return; fi
            done
            fail "Program nebyl nalezen v Debianu: $1" ;;
    esac
    resolve "$path"
}

patch_one() {
    local src dst hash old_rpath tmp
    local requested_dst=${2:-}
    src=$(source_path "$1")
    [[ -f $src ]] || fail "Soubor neexistuje: $src"
    hash=$(printf '%s' "$src" | sha256sum); hash=${hash%% *}
    dst=${requested_dst:-$N/bin/$(basename "$src")-${hash:0:16}}
    old_rpath=$(patchelf --print-rpath "$src")
    if [[ -z $requested_dst ]]; then
        old_rpath=${old_rpath//\$\{ORIGIN\}/$(dirname "$src")}
        old_rpath=${old_rpath//\$ORIGIN/$(dirname "$src")}
    fi
    tmp=$(mktemp "$(dirname "$dst")/.patch.XXXXXX")
    cp "$src" "$tmp"
    chmod 755 "$tmp"
    # Separate calls, RPATH first: the opposite order corrupts some non-PIE ELFs.
    if ! patchelf --force-rpath --set-rpath "$LIBPATH${old_rpath:+:$old_rpath}" "$tmp" ||
       ! patchelf --set-interpreter "$PLIB/ld.so" "$tmp" ||
       ! patchelf --add-needed "$N/lib/pathhook.so" "$tmp"; then
        rm -f "$tmp"
        fail "Úprava programu selhala: $src"
    fi
    # DT_NEEDED preserves the hook on /proc/self/exe re-exec without LD_PRELOAD.
    mv -f "$tmp" "$dst"
    printf '%s\n' "$dst"
}

mirror_app() {
    local src name dst entry interp
    src=$(source_path "$1")
    [[ -d $src ]] || fail "Adresář neexistuje: $src"
    name=$(basename "$src")
    [[ $name != . && $name != .. && -n $name ]] || fail 'Neplatný název aplikace.'
    dst=$N/apps/$name
    mkdir -p "$dst"
    while IFS= read -r -d '' entry; do
        interp=
        if [[ -f $entry && -x $entry ]]; then
            interp=$(patchelf --print-interpreter "$entry" 2>/dev/null || true)
        fi
        case $interp in
            /lib/ld-linux-aarch64.so.1|/lib64/ld-linux-x86-64.so.2)
                patch_one "$entry" "$dst/$(basename "$entry")" >/dev/null
                continue ;;
        esac
        ln -sfn "$entry" "$dst/$(basename "$entry")"
    done < <(find "$src" -mindepth 1 -maxdepth 1 -print0)
    if [[ -n ${2:-} ]]; then
        [[ $2 != */* && -x $dst/$2 ]] || fail "Program aplikace nebyl nalezen: $2"
        printf 'Spuštění: droiddesk-glibc-native run %q --no-sandbox --disable-dev-shm-usage --password-store=basic\n' "$dst/$2"
    else
        printf 'Aplikace je připravena v %s; spusťte droiddesk-glibc-native run CESTA_K_PROGRAMU --no-sandbox --disable-dev-shm-usage --password-store=basic\n' "$dst"
    fi
}

need_patchelf() { command -v patchelf >/dev/null || fail 'Chybí patchelf. Spusťte: pkg install patchelf'; }

run_native() {
    ready
    [[ $# -gt 0 ]] || fail 'Použití: droiddesk-glibc-native run PŘÍKAZ [ARGUMENTY]'
    local saved_preload=${LD_PRELOAD-} saved_library=${LD_LIBRARY_PATH-} saved_path=${PATH-}
    local timezone=${TZ:-} variable locale
    local -a saved=("DD_SAVED_PREFIX=$PREFIX")
    while IFS= read -r variable; do
        saved+=("DD_SAVED_$variable=${!variable}")
    done < <(compgen -e | while IFS= read -r variable; do
        case $variable in TERMUX_*) printf '%s\n' "$variable" ;; esac
    done)
    if [[ -z $timezone ]]; then
        timezone=$(/system/bin/getprop persist.sys.timezone 2>/dev/null || true)
    fi
    locale=$(native_locale)
    exec 63< "$R/etc/resolv.conf"
    # Debian env delegates the initial command to the hook, including PATH and shebangs.
    exec "$PREFIX/bin/env" -i \
        "HOME=${HOME:-$R/root}" "TERM=${TERM:-xterm-256color}" "LANG=$locale" \
        'PATH=/usr/local/bin:/usr/bin:/bin' "LOCPATH=$N/locale:$R/usr/lib/locale" \
        "TZDIR=$R/usr/share/zoneinfo" "TZ=$timezone" "${saved[@]}" \
        "FONTCONFIG_SYSROOT=$R" 'FONTCONFIG_FILE=/etc/fonts/fonts.conf' \
        "SSL_CERT_FILE=$R/etc/ssl/certs/ca-certificates.crt" "GCONV_PATH=$R/usr/lib/aarch64-linux-gnu/gconv" \
        "DISPLAY=$T/.X11-unix/X0" "TMPDIR=$T" 'GLIBC_TUNABLES=glibc.pthread.rseq=0' \
        "DD_ROOTFS=$R" "DD_TMP=$T" "DD_PLIB=$PLIB" "DD_LIBPATH=$LIBPATH" \
        "DD_SAVED_LD_PRELOAD=$saved_preload" "DD_SAVED_LD_LIBRARY_PATH=$saved_library" "DD_SAVED_PATH=$saved_path" \
        "$PLIB/ld.so" --library-path "$LIBPATH" --preload "$N/lib/pathhook.so" \
        "$R/usr/bin/env" -- "$@"
}

claude_native() {
    ready
    need_python
    local candidate target home=${DD_CLAUDE_HOME:-$R/root}
    if [[ ${1:-} == --home ]]; then
        [[ $# -ge 2 ]] || fail 'Použití: droiddesk-glibc-native claude [--home ADRESÁŘ] [ARGUMENTY]'
        home=$2; shift 2
    fi
    case $home in /root|/root/*|/home|/home/*) home=$R$home ;; esac
    if [[ $home == "$R/root" ]]; then
        printf 'Varování: Nativní Claude sdílí ~/.claude s relací Claude v prootu.\n' >&2
    fi
    # Bun does file access with its own system calls, past pathhook: the built-in Read, Grep,
    # Glob and Edit tools only see real paths (Tab S10 FE). Start in the real path of the
    # project directory, like claude-tmux does under proot; DD_CLAUDE_DIR overrides it.
    local project=${DD_CLAUDE_DIR:-$R/root/projekty/Claude}
    case $project in /root|/root/*|/home|/home/*) project=$R$project ;; esac
    mkdir -p "$project" && cd "$project" || fail "Adresář projektu nejde otevřít: $project"
    # The native auto-updater installed a second 281 MB copy into the config HOME.
    local -a claude_env=(/usr/bin/env DISABLE_AUTOUPDATER=1)
    # Installation lookup stays in the Debian home even with an isolated config HOME.
    candidate=$R/root/.local/bin/claude
    if [[ -e $candidate || -L $candidate ]]; then
        target=$(resolve "$candidate")
        if [[ -f $target && $(head -c 4 "$target") == $'\177ELF' ]]; then
            # Bun single-file ELFs contain absolute references: never patchelf them.
            HOME=$home run_native "${claude_env[@]}" "$target" "$@"
        elif [[ -f $target ]]; then
            HOME=$home run_native "${claude_env[@]}" /usr/bin/node "$target" "$@"
        fi
    fi
    for candidate in "$R/usr/local/lib/node_modules/@anthropic-ai/claude-code/cli.js" \
                     "$R/usr/lib/node_modules/@anthropic-ai/claude-code/cli.js" \
                     "$R/root/.npm-global/lib/node_modules/@anthropic-ai/claude-code/cli.js"; do
        if [[ -f $candidate ]]; then HOME=$home run_native "${claude_env[@]}" /usr/bin/node "$candidate" "$@"; fi
    done
    fail 'Claude Code nebyl v Debianu nalezen. Nejdříve jej nainstalujte pomocí aplikace.'
}

selftest() {
    ready
    local failed=0 name
    for name in true shell python git node; do
        local -a args
        case $name in
            true) args=(/usr/bin/true) ;;
            shell) args=(/bin/sh -c 'test -f /etc/debian_version && /usr/bin/true && git --version') ;;
            python) args=(/usr/bin/python3 -c 'import ssl, locale; print(ssl.OPENSSL_VERSION); print(locale.setlocale(locale.LC_ALL, ""))') ;;
            git) args=(/usr/bin/git --version) ;;
            node) [[ -x $R/usr/bin/node ]] || { printf 'SKIP node (není nainstalován)\n'; continue; }; args=(/usr/bin/node -e 'console.log(process.version)') ;;
        esac
        if (run_native "${args[@]}"); then printf 'OK %s\n' "$name"; else printf 'FAIL %s\n' "$name"; failed=1; fi
    done
    return "$failed"
}

command=${1:-}; [[ $# == 0 ]] || shift
case $command in
    setup) setup ;;
    patch) ready; need_python; need_patchelf; [[ $# -gt 0 ]] || fail 'Použití: droiddesk-glibc-native patch PROGRAM...'; for binary in "$@"; do if [[ -d $(source_path "$binary") ]]; then mirror_app "$binary"; else patch_one "$binary"; fi; done ;;
    app) ready; need_python; need_patchelf; [[ $# == 2 ]] || fail 'Použití: droiddesk-glibc-native app ADRESÁŘ PROGRAM'; mirror_app "$@" ;;
    run) run_native "$@" ;;
    claude) claude_native "$@" ;;
    selftest) selftest ;;
    *) fail 'Použití: droiddesk-glibc-native {setup|patch PROGRAM...|app ADRESÁŘ PROGRAM|run PŘÍKAZ [ARGUMENTY]|claude [ARGUMENTY]|selftest}' ;;
esac
