#!/usr/bin/env bash
# Debian glibc launcher. Run this from Termux, outside proot.
set -euo pipefail

PREFIX=${PREFIX:-$(cd "$(dirname "$0")/.." && pwd)}
R=$PREFIX/var/lib/proot-distro/containers/debian/rootfs
N=$PREFIX/opt/glibc-native
PLIB=$N/plib
SHARE=$N/share
T=${PREFIX%/usr}/tmp
LIBPATH=$PLIB:$N/lib:$R/lib/aarch64-linux-gnu:$R/usr/lib/aarch64-linux-gnu
[[ ! -s $N/libpaths ]] || LIBPATH+=:$(< "$N/libpaths")
fail() { printf 'Chyba: %s\n' "$*" >&2; exit 1; }
need_python() { command -v python3 >/dev/null || fail 'Chybí Termux Python. Spusťte: pkg install python'; }

# Walk components before handling .., so links behave as they do inside Debian.
# REPLY avoids a command-substitution fork for every PATH candidate. Only actual
# symlinks require readlink; absolute targets stay rooted in the Debian rootfs.
resolve_into() {
    local pending=$1 current= floor= part candidate link links=0
    REPLY=
    [[ $pending == /* ]] || pending=$PWD/$pending
    case $pending in
        "$R"|"$R"/*) current=$R floor=$R; pending=${pending#"$R"} ;;
    esac
    while [[ -n $pending ]]; do
        part=${pending%%/*}
        if [[ $pending == */* ]]; then pending=${pending#*/}; else pending=; fi
        case $part in
            ''|.) continue ;;
            ..)
                if [[ $current != "$floor" ]]; then current=${current%/*}; fi
                continue ;;
        esac
        candidate=$current/$part
        # A host-side link may enter the rootfs before a later Debian link.
        [[ $candidate != "$R" ]] || floor=$R
        if [[ -L $candidate ]]; then
            if (( ++links > 40 )); then
                printf 'Příliš mnoho symbolických odkazů: %s\n' "$1" >&2
                return 1
            fi
            link=$(readlink -- "$candidate") || return 1
            case $link in
                "$R"|"$R"/*) current=$R floor=$R; link=${link#"$R"} ;;
                /*)
                    current=$floor ;;
            esac
            pending=$link${pending:+/$pending}
        else
            [[ -z $pending || -d $candidate ]] || return 1
            current=$candidate
        fi
    done
    REPLY=${current:-/}
}
resolve() { resolve_into "$1" && printf '%s\n' "$REPLY"; }

setup() {
    need_python
    [[ -f $SHARE/pathhook.so ]] || fail 'Chybí pathhook.so. Sestavte jej pomocí tools/glibc-native/build.sh a znovu sestavte aplikaci.'
    [[ -f $SHARE/patch-glibc.py ]] || fail 'Chybí patch-glibc.py v instalaci aplikace.'
    local ld libc uv signature stage
    ld=$(resolve "$R/usr/lib/aarch64-linux-gnu/ld-linux-aarch64.so.1")
    libc=$(resolve "$R/usr/lib/aarch64-linux-gnu/libc.so.6")
    uv=$(resolve "$R/usr/lib/aarch64-linux-gnu/libuv.so.1")
    [[ -f $ld && -f $libc ]] || fail 'Chybí Debian glibc. Nejdříve nainstalujte Debian v aplikaci.'
    mkdir -p "$PLIB" "$N/bin" "$N/lib"
    signature=$({ sha256sum "$ld" "$libc" "$SHARE/patch-glibc.py" "$SHARE/pathhook.so"; [[ ! -f $uv ]] || sha256sum "$uv"; } | sha256sum)
    if [[ -f $N/stamp && $(< "$N/stamp") == "$signature" && -f $PLIB/ld.so && -f $PLIB/libc.so.6 && -f $N/lib/pathhook.so ]] && { [[ ! -f $uv ]] || [[ -f $PLIB/libuv.so.1 ]]; }; then
        setup_data
        printf 'Nativní glibc je aktuální.\n'
        return
    fi
    stage=$(mktemp -d "$N/.setup.XXXXXX")
    # Publish only after every required pattern matched; leave the previous setup usable.
    if ! python3 "$SHARE/patch-glibc.py" ld "$ld" "$stage/ld.so" ||
       ! python3 "$SHARE/patch-glibc.py" libc "$libc" "$stage/libc.so.6" ||
       { [[ -f $uv ]] && ! python3 "$SHARE/patch-glibc.py" libuv "$uv" "$stage/libuv.so.1"; }; then
        rm -rf "$stage"
        fail 'Úprava glibc selhala. V Debianu se změnily očekávané instrukce; instalace nebyla aktualizována.'
    fi
    cp "$SHARE/pathhook.so" "$stage/pathhook.so"
    chmod 755 "$stage/pathhook.so"
    mv -f "$stage/ld.so" "$stage/libc.so.6" "$PLIB/"
    if [[ -f $stage/libuv.so.1 ]]; then mv -f "$stage/libuv.so.1" "$PLIB/"; else rm -f "$PLIB/libuv.so.1"; fi
    mv -f "$stage/pathhook.so" "$N/lib/pathhook.so"
    printf '%s\n' "$signature" > "$stage/stamp"
    mv -f "$stage/stamp" "$N/stamp"
    rmdir "$stage"
    setup_data
    printf 'Nativní glibc je připravena.\n'
}

load_library_paths() {
    LIBPATH=$PLIB:$N/lib:$R/lib/aarch64-linux-gnu:$R/usr/lib/aarch64-linux-gnu
    [[ ! -s $N/libpaths ]] || LIBPATH+=:$(< "$N/libpaths")
}

scan_library_paths() {
    # ld.so reads DT_RPATH/DT_RUNPATH internally, past pathhook. Parse program
    # headers (section headers may be stripped); never execute a rootfs tool.
    python3 - "$@" <<'PY'
import mmap, os, struct, sys

def elf_runpaths(data):
    if len(data) < 64 or data[:6] != b'\x7fELF\x02\x01':
        return []
    try:
        phoff = struct.unpack_from('<Q', data, 32)[0]
        entsize, count = struct.unpack_from('<HH', data, 54)
        if entsize < 56 or phoff + entsize * count > len(data):
            return []
        loads, dynamic = [], []
        for i in range(count):
            kind, _, off, addr, _, size, _, _ = struct.unpack_from('<II6Q', data, phoff + i * entsize)
            if off + size > len(data):
                return []
            if kind == 1:
                loads.append((addr, off, size))
            elif kind == 2:
                dynamic.append((off, size))
        table = length = None
        strings = []
        for off, size in dynamic:
            for pos in range(off, off + size - 15, 16):
                tag, value = struct.unpack_from('<qQ', data, pos)
                if tag == 0:
                    break
                if tag == 5:
                    table = value
                elif tag == 10:
                    length = value
                elif tag in (15, 29):
                    strings.append(value)
        if table is None or length is None:
            return []
        for addr, off, size in loads:
            if addr <= table < addr + size:
                start = off + table - addr
                end = start + min(length, size - (table - addr))
                break
        else:
            return []
        paths = []
        for index in strings:
            if index >= end - start:
                continue
            nul = data.find(b'\0', start + index, end)
            if nul < 0:
                continue
            for path in os.fsdecode(data[start + index:nul]).split(':'):
                # Dynamic tokens need loader context; only literal absolute dirs belong here.
                if path.startswith('/') and '$' not in path and '\n' not in path and '\r' not in path:
                    paths.append(path)
        return paths
    except (ValueError, struct.error):
        return []

if __name__ == '__main__':
    paths, seen = set(), set()
    for directory in sys.argv[1:]:
        for parent, _, names in os.walk(directory):
            for name in names:
                if not (name.endswith('.so') or '.so.' in name):
                    continue
                file = os.path.join(parent, name)
                if os.path.islink(file):
                    continue
                real = os.path.realpath(file)
                if real in seen:
                    continue
                seen.add(real)
                with open(file, 'rb') as src:
                    if os.fstat(src.fileno()).st_size:
                        with mmap.mmap(src.fileno(), 0, access=mmap.ACCESS_READ) as data:
                            paths.update(elf_runpaths(data))
    for path in sorted(paths):
        print(path)
PY
}

setup_libraries() {
    local dir entry target stage newer= paths= separator=
    local -a dirs=()
    for dir in "$R/lib" "$R/usr/lib"; do
        resolve_into "$dir" || continue
        [[ ! -d $REPLY ]] || dirs+=("$REPLY")
    done
    [[ ${#dirs[@]} -gt 0 ]] || return 1
    if [[ -f $N/lib/.links && -f $N/libpaths ]]; then
        # Include subdirectories: apt can change pulseaudio without touching usr/lib.
        newer=$(find -H "${dirs[@]}" -type d -newer "$N/lib/.links" -print -quit) || return 1
        if [[ -z $newer ]]; then load_library_paths; return 0; fi
    fi
    stage=$(mktemp -d "$N/lib/.links.XXXXXX") || return 1
    # Timestamp before scanning so concurrent apt changes cause another pass.
    touch "$stage/stamp" || { rmdir "$stage"; return 1; }
    for dir in "$R/lib/aarch64-linux-gnu" "$R/usr/lib/aarch64-linux-gnu"; do
        [[ -d $dir ]] || continue
        for entry in "$dir"/*; do
            [[ -L $entry ]] || continue
            target=$(readlink -- "$entry") || continue
            [[ $target == /* ]] || continue
            resolve_into "$entry" || continue
            [[ -f $REPLY ]] || continue
            # Each refresher has private staging names; publication is atomic.
            if ! ln -s "$REPLY" "$stage/${entry##*/}" ||
               ! mv -f "$stage/${entry##*/}" "$N/lib/${entry##*/}"; then
                rm -rf "$stage"
                printf 'Varování: Odkazy knihoven se nepodařilo aktualizovat.\n' >&2
                return 1
            fi
        done
    done
    if ! scan_library_paths "${dirs[@]}" > "$stage/directories"; then
        rm -rf "$stage"
        printf 'Varování: Cesty knihoven se nepodařilo načíst.\n' >&2
        return 1
    fi
    while IFS= read -r dir; do
        resolve_into "$R$dir" || continue
        [[ -d $REPLY ]] || continue
        paths+=$separator$REPLY; separator=:
    done < "$stage/directories"
    printf '%s' "$paths" > "$stage/libpaths"
    rm -f "$stage/directories"
    mv -f "$stage/libpaths" "$N/libpaths" &&
        mv -f "$stage/stamp" "$N/lib/.links" && rmdir "$stage" || return 1
    load_library_paths
}

setup_data() {
    local locale input stage
    mkdir -p "$N/locale"
    setup_libraries
    # LOCPATH bypasses locale-archive; localedef must publish directory locales.
    for locale in C.UTF-8 "${LANG:-C.UTF-8}" cs_CZ.UTF-8 en_US.UTF-8; do
        [[ $locale != C && $locale != POSIX && $locale != */* ]] || continue
        [[ ! -d $N/locale/$locale ]] || continue
        input=${locale%%.*}; input=${input%%@*}
        [[ -f $R/usr/share/i18n/locales/$input && -f $R/usr/share/i18n/charmaps/UTF-8.gz && -x $R/usr/bin/localedef ]] || continue
        stage=$(mktemp -d "$N/locale/.build.XXXXXX")
        if (run_native /usr/bin/env "I18NPATH=$R/usr/share/i18n" /usr/bin/localedef --no-archive -i "$input" -f UTF-8 "$stage/$locale"); then
            mv -T "$stage/$locale" "$N/locale/$locale"
        else
            printf 'Varování: Nepodařilo se vytvořit locale %s.\n' "$locale" >&2
        fi
        rm -rf "$stage"
    done
    if [[ -d $R/usr/lib/locale/C.utf8 && ! -e $N/locale/C.UTF-8 ]]; then
        ln -s "$R/usr/lib/locale/C.utf8" "$N/locale/C.UTF-8"
    fi
}

native_locale_into() {
    local requested=${1:-${LANG:-C.UTF-8}} normalized
    normalized=${requested//UTF-8/utf8}
    if [[ $requested == C || $requested == POSIX || ( $requested != */* && ( -d $N/locale/$requested || -d $N/locale/$normalized ) ) ]]; then
        REPLY=$requested
    else
        REPLY=C.UTF-8
    fi
}
native_locale() { native_locale_into "${1:-}"; printf '%s\n' "$REPLY"; }

native_timezone() {
    REPLY=${TZ:-}
    [[ -z $REPLY ]] || return 0
    local now stamp= cached= file=$N/timezone.cache temporary
    if [[ -n ${EPOCHSECONDS:-} ]]; then now=$EPOCHSECONDS
    else printf -v now '%(%s)T' -1; fi
    if [[ -r $file ]]; then
        { IFS= read -r stamp && IFS= read -r cached; } < "$file" || stamp=
    fi
    if [[ -n $stamp && $stamp != *[!0-9]* && ${#stamp} -le 12 ]] &&
       (( now >= 10#$stamp && now - 10#$stamp < 3600 )); then
        REPLY=$cached
        return 0
    fi
    REPLY=$(/system/bin/getprop persist.sys.timezone 2>/dev/null) || REPLY=
    # Cache even an empty result. A private file keeps concurrent readers from
    # observing half a record; cache failure never prevents launching a command.
    temporary=$file.$BASHPID
    { printf '%s\n%s\n' "$now" "$REPLY" > "$temporary" && mv -f "$temporary" "$file"; } 2>/dev/null || true
}

ready() {
    [[ -f $N/stamp && -x $PLIB/ld.so && -f $N/lib/pathhook.so ]] || fail 'Nejdříve spusťte: droiddesk-glibc-native setup'
}

source_path_into() {
    local path=$1 dir
    REPLY=
    case $path in
        /root|/root/*|/home|/home/*|/usr|/usr/*|/etc|/etc/*|/var|/var/*|/opt|/opt/*|/lib|/lib/*|/bin|/bin/*|/sbin|/sbin/*) path=$R$path ;;
        /*) ;;
        */*) path=$PWD/$path ;;
        *)
            for dir in /usr/local/sbin /usr/local/bin /usr/sbin /usr/bin /sbin /bin; do
                resolve_into "$R$dir/$1" || continue
                [[ -f $REPLY && -x $REPLY ]] && return 0
            done
            REPLY=
            return 1 ;;
    esac
    resolve_into "$path"
}
source_path() {
    source_path_into "$1" || fail "Program nebyl nalezen v Debianu: $1"
    printf '%s\n' "$REPLY"
}

patch_one() {
    local src dst hash old_rpath tmp
    local requested_dst=${2:-}
    src=$(source_path "$1")
    [[ -f $src ]] || fail "Soubor neexistuje: $src"
    hash=$(printf '%s' "$src" | sha256sum); hash=${hash%% *}
    dst=${requested_dst:-$N/bin/$(basename "$src")-${hash:0:16}}
    old_rpath=$(patchelf --print-rpath "$src")
    if [[ -z $requested_dst ]]; then
        old_rpath=${old_rpath//\$\{ORIGIN\}/$(dirname "$src")}
        old_rpath=${old_rpath//\$ORIGIN/$(dirname "$src")}
    fi
    tmp=$(mktemp "$(dirname "$dst")/.patch.XXXXXX")
    cp "$src" "$tmp"
    chmod 755 "$tmp"
    # Separate calls, RPATH first: the opposite order corrupts some non-PIE ELFs.
    if ! patchelf --force-rpath --set-rpath "$LIBPATH${old_rpath:+:$old_rpath}" "$tmp" ||
       ! patchelf --set-interpreter "$PLIB/ld.so" "$tmp" ||
       ! patchelf --add-needed "$N/lib/pathhook.so" "$tmp"; then
        rm -f "$tmp"
        fail "Úprava programu selhala: $src"
    fi
    # DT_NEEDED preserves the hook on /proc/self/exe re-exec without LD_PRELOAD.
    mv -f "$tmp" "$dst"
    printf '%s\n' "$dst"
}

mirror_app() {
    local src name dst entry interp
    src=$(source_path "$1")
    [[ -d $src ]] || fail "Adresář neexistuje: $src"
    name=$(basename "$src")
    [[ $name != . && $name != .. && -n $name ]] || fail 'Neplatný název aplikace.'
    dst=$N/apps/$name
    mkdir -p "$dst"
    while IFS= read -r -d '' entry; do
        interp=
        if [[ -f $entry && -x $entry ]]; then
            interp=$(patchelf --print-interpreter "$entry" 2>/dev/null || true)
        fi
        case $interp in
            /lib/ld-linux-aarch64.so.1|/lib64/ld-linux-x86-64.so.2)
                patch_one "$entry" "$dst/$(basename "$entry")" >/dev/null
                continue ;;
        esac
        ln -sfn "$entry" "$dst/$(basename "$entry")"
    done < <(find "$src" -mindepth 1 -maxdepth 1 -print0)
    if [[ -n ${2:-} ]]; then
        [[ $2 != */* && -x $dst/$2 ]] || fail "Program aplikace nebyl nalezen: $2"
        printf 'Spuštění: droiddesk-glibc-native run %q --no-sandbox --disable-dev-shm-usage --password-store=basic\n' "$dst/$2"
    else
        printf 'Aplikace je připravena v %s; spusťte droiddesk-glibc-native run CESTA_K_PROGRAMU --no-sandbox --disable-dev-shm-usage --password-store=basic\n' "$dst"
    fi
}

need_patchelf() { command -v patchelf >/dev/null || fail 'Chybí patchelf. Spusťte: pkg install patchelf'; }

electron_elf() {
    local target=$1 dir=${1%/*}
    [[ $(head -c 4 "$target") == $'\177ELF' ]] || return 1
    [[ ! -f $dir/resources/app.asar && ! -d $dir/resources/app ]] || return 0
    # Reject ordinary ELFs cheaply before inspecting .rodata, without readelf/binutils.
    LC_ALL=C grep -aFq electron "$target" || return 1
    python3 - "$target" <<'PY'
import mmap, struct, sys
try:
    with open(sys.argv[1], 'rb') as src, mmap.mmap(src.fileno(), 0, access=mmap.ACCESS_READ) as data:
        if data[:6] != b'\x7fELF\x02\x01':
            sys.exit(1)
        off = struct.unpack_from('<Q', data, 40)[0]
        size, count, names = struct.unpack_from('<HHH', data, 58)
        if size < 64 or not count or names >= count or off + size * count > len(data):
            sys.exit(1)
        def section(index):
            return struct.unpack_from('<II4QII2Q', data, off + size * index)
        strings = section(names)
        start, length = strings[4:6]
        table = data[start:start + length]
        for index in range(count):
            entry = section(index)
            name, start, length = entry[0], entry[4], entry[5]
            if table[name:name + 8] == b'.rodata\0' and start + length <= len(data):
                sys.exit(0 if data.find(b'electron', start, start + length) >= 0 else 1)
except (OSError, ValueError, struct.error):
    pass
sys.exit(1)
PY
}

electron_mirror_into() {
    local target=$1 dir=${1%/*} name signature= stamp dst
    name=${dir##*/}
    [[ -n $name && $name != . && $name != .. ]] || return 1
    dst=$N/apps/$name
    stamp=$dst/.electron-stamp
    # A warm Electron launch needs only stat and a builtin stamp read; no ELF scan.
    if [[ -f $stamp ]]; then signature=$target$'\n'$(stat -c '%s:%y' -- "$target") || return 2; fi
    if [[ -z $signature || $(< "$stamp") != "$signature" || ! -f $dst/${target##*/} ]]; then
        electron_elf "$target" || return 1
        command -v patchelf >/dev/null || return 3
        [[ -n $signature ]] || signature=$target$'\n'$(stat -c '%s:%y' -- "$target") || return 2
        # Reuse app's executable copies, adjacent symlinks and DT_NEEDED hook.
        # A failed rebuild leaves no valid stamp and is retried on the next launch.
        rm -f "$stamp"
        (mirror_app "$dir") > /dev/null || return 2
        printf '%s\n' "$signature" > "$stamp" || return 2
    else
        command -v patchelf >/dev/null || return 3
    fi
    # Electron re-launches itself with an environment that has lost the native runtime and
    # the session bus: libdbus then found the Termux bus through X11 and activated the Termux
    # keyring (Tab S10 FE, fold.99). pathhook restores these from the mirror when missing.
    load_library_paths
    local env_file=$dst/.dd-env env_text
    env_text="DD_ROOTFS=$R"$'\n'"DD_TMP=$T"$'\n'"DD_PLIB=$PLIB"$'\n'"DD_LIBPATH=$LIBPATH"$'\n'
    env_text+="DD_NATIVE_ACTIVE=1"$'\n'"DBUS_SESSION_BUS_ADDRESS=unix:path=/tmp/dbus-debian"$'\n'
    if [[ ! -f $env_file || $(< "$env_file")$'\n' != "$env_text" ]]; then
        printf '%s' "$env_text" > "$env_file.new" && mv -f "$env_file.new" "$env_file" || return 2
    fi
    REPLY=$dst/${target##*/}
}

run_native() {
    ready
    load_library_paths
    [[ $# -gt 0 ]] || fail 'Použití: droiddesk-glibc-native run PŘÍKAZ [ARGUMENTY]'
    local saved_preload=${LD_PRELOAD-} saved_library=${LD_LIBRARY_PATH-} saved_path=${PATH-}
    local timezone variable locale
    local -a desktop=() extra=() saved=("DD_SAVED_PREFIX=$PREFIX")
    # Prefix expansion enumerates names in this shell. Indirect attribute
    # expansion filters exported variables without compgen subprocesses/pipes.
    read -r -a extra <<< "${DD_NATIVE_PASS:-}"
    for variable in DISPLAY COLORTERM GALLIUM_DRIVER \
        GBM_BACKENDS_PATH "${!MESA_@}" "${!LIBGL_@}" "${!VK_@}" "${!__GLX_@}" \
        "${!__EGL_@}" "${!LC_@}" "${!TERMUX_@}"; do
        [[ -v $variable && ${!variable@a} == *x* ]] || continue
        case $variable in
            TERMUX_*) saved+=("DD_SAVED_$variable=${!variable}") ;;
            *) extra+=("$variable") ;;
        esac
    done
    for variable in "${extra[@]}"; do
        [[ $variable =~ ^[a-zA-Z_][a-zA-Z_0-9]*$ && -v $variable ]] || continue
        case $variable in
            DBUS_SESSION_BUS_ADDRESS|LD_*|PREFIX|TERMUX_*|DD_*|PATH|HOME|TMPDIR|LANG|TERM|LOCPATH|GCONV_PATH|GLIBC_TUNABLES|BASH_ENV|ENV|SHELLOPTS|BASHOPTS) continue ;;
        esac
        # A Termux GUI session can export bionic driver/module paths.
        [[ ${!variable} != *"$PREFIX"* ]] || continue
        case $variable in
            LC_*) native_locale_into "${!variable}"; desktop+=("$variable=$REPLY") ;;
            *) desktop+=("$variable=${!variable}") ;;
        esac
    done
    native_timezone; timezone=$REPLY
    native_locale_into; locale=$REPLY
    exec 63< "$R/etc/resolv.conf"
    # Debian bash applies the GUI policy, then delegates PATH and shebangs to the hook.
    exec "$PREFIX/bin/env" -i \
        "HOME=${HOME:-$R/root}" "TERM=${TERM:-xterm-256color}" "LANG=$locale" \
        'PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin' "LOCPATH=$N/locale:$R/usr/lib/locale" \
        "TZDIR=$R/usr/share/zoneinfo" "TZ=$timezone" "${saved[@]}" \
        "FONTCONFIG_SYSROOT=$R" 'FONTCONFIG_FILE=/etc/fonts/fonts.conf' \
        "SSL_CERT_FILE=$R/etc/ssl/certs/ca-certificates.crt" "GCONV_PATH=$R/usr/lib/aarch64-linux-gnu/gconv" \
        'DISPLAY=:0' 'DBUS_SESSION_BUS_ADDRESS=unix:path=/tmp/dbus-debian' "${desktop[@]}" \
        "TMPDIR=$T" 'GLIBC_TUNABLES=glibc.pthread.rseq=0' \
        'DD_NATIVE_ACTIVE=1' "DD_ROOTFS=$R" "DD_TMP=$T" "DD_PLIB=$PLIB" "DD_LIBPATH=$LIBPATH" \
        "DD_SAVED_LD_PRELOAD=$saved_preload" "DD_SAVED_LD_LIBRARY_PATH=$saved_library" "DD_SAVED_PATH=$saved_path" \
        "$PLIB/ld.so" --library-path "$LIBPATH" --preload "$N/lib/pathhook.so" \
        "$R/usr/bin/bash" -c '
            # Reuse Debian Mesa policy, including virpipe and the GPU off switch.
            if [ -f /etc/profile.d/droiddesk-gui.sh ]; then . /etc/profile.d/droiddesk-gui.sh; fi
            # The Adreno profile adds Debian libraries; the hook uses DD_LIBPATH for exec.
            native_libs=
            IFS=: read -r -a native_dirs <<< "${LD_LIBRARY_PATH-}"
            for native_dir in "${native_dirs[@]}"; do
                case $native_dir in
                    /opt/*|/usr/*|/lib/*) native_libs+=${DD_ROOTFS}${native_dir}: ;;
                esac
            done
            export DD_LIBPATH=$DD_PLIB:${native_libs}${DD_LIBPATH#*:}
            unset LD_PRELOAD LD_LIBRARY_PATH native_libs native_dirs native_dir
            exec "$@"
        ' droiddesk-native "$@"
}

native_ready() {
    [[ -f $N/stamp && -x $PLIB/ld.so && -f $PLIB/libc.so.6 && -f $N/lib/pathhook.so &&
       -f $R/etc/resolv.conf && -x $R/usr/bin/bash && -d $R/root ]]
}

native_enabled() { [[ ! -e $N/off && ${DD_NATIVE:-1} != 0 ]]; }

native_switch() {
    mkdir -p "$N"
    case $1 in
        on) rm -f "$N/off"; printf 'Nativní běh je zapnutý.\n' ;;
        off) touch "$N/off"; printf 'Nativní běh je vypnutý; použije se proot.\n' ;;
        status)
            if ! native_enabled; then printf 'Nativní běh je vypnutý.\n'
            elif native_ready; then printf 'Nativní běh je připravený a zapnutý.\n'
            else printf 'Nativní běh není připravený; použije se proot.\n'; fi
            if [[ -s $N/proot-list ]]; then
                printf 'Programy s naučeným fallbackem na proot:\n'
                sort -u "$N/proot-list"
            else printf 'Seznam naučených fallbacků je prázdný.\n'; fi ;;
    esac
}

proot_list_update() {
    # Concurrent GUI starts and resets share a lock; readers see an atomic snapshot.
    python3 - "$N/proot-list" "$1" "${2:-}" <<'PY'
import fcntl, os, sys, tempfile
path, action, name = sys.argv[1:]
os.makedirs(os.path.dirname(path), exist_ok=True)
with open(path + '.lock', 'a') as lock:
    fcntl.flock(lock, fcntl.LOCK_EX)
    try:
        with open(path) as src:
            names = set(src.read().splitlines())
    except FileNotFoundError:
        names = set()
    if action == 'add':
        names.add(name)
    elif name == '--all':
        names.clear()
    else:
        names.discard(name)
    with tempfile.NamedTemporaryFile(mode='w', dir=os.path.dirname(path), delete=False) as dst:
        dst.writelines(n + '\n' for n in sorted(names))
    os.replace(dst.name, path)
PY
}

program_name_valid() { [[ -n $1 && $1 != */* && $1 != *[[:cntrl:]]* ]]; }

native_learn() {
    [[ $# == 1 ]] || fail 'Použití: droiddesk-glibc-native learn NÁZEV'
    program_name_valid "$1" && [[ $1 != --all ]] || fail 'Zadejte samotný název programu bez cesty.'
    need_python
    proot_list_update add "$1"
    printf 'Fallback na proot byl uložen: %s\n' "$1"
}

native_reset() {
    [[ $# == 1 ]] || fail 'Použití: droiddesk-glibc-native reset NÁZEV|--all'
    program_name_valid "$1" || fail 'Zadejte samotný název programu bez cesty.'
    need_python
    proot_list_update remove "$1"
    if [[ $1 == --all ]]; then
        printf 'Všechny naučené fallbacky byly odstraněny.\n'
    else
        printf 'Naučený fallback byl odstraněn: %s\n' "$1"
    fi
}

native_target_into() {
    if [[ $1 == */* && $1 != /* ]]; then resolve_into "$R/root/$1"
    else source_path_into "$1"; fi
}
native_target() { native_target_into "$1" && printf '%s\n' "$REPLY"; }

native_program_into() {
    local resolved_command=$1 resolved_target=$2 target
    shift 2
    local argc=$#
    REPLY=
    REPLY_TARGET= REPLY_INDEX=
    # Retain the program's argv index so Electron can replace only that word.
    while [[ $# -gt 0 ]]; do
        case ${1##*/} in
            env)
                shift
                while [[ $# -gt 0 ]]; do
                    case $1 in
                        -i|-0|--ignore-environment|--null|--unset=*) shift ;;
                        -u|--unset) [[ $# -ge 2 ]] || return 1; shift 2 ;;
                        --) shift; break ;;
                        -*) return 1 ;;
                        *) [[ $1 =~ ^[a-zA-Z_][a-zA-Z_0-9]*= ]] && { shift; continue; }; break ;;
                    esac
                done ;;
            gpu-run|electron-run) shift ;;
            nice)
                shift
                case ${1:-} in -n|--adjustment) [[ $# -ge 2 ]] || return 1; shift 2 ;; --adjustment=*|-[0-9]*) shift ;; esac
                [[ ${1:-} != -- ]] || shift ;;
            setsid)
                shift
                while [[ ${1:-} == -f || ${1:-} == -w || ${1:-} == --fork || ${1:-} == --wait ]]; do shift; done
                [[ ${1:-} != -- ]] || shift ;;
            stdbuf)
                shift
                while [[ $# -gt 0 ]]; do
                    case $1 in
                        -i|-o|-e) [[ $# -ge 2 ]] || return 1; shift 2 ;;
                        -i?*|-o?*|-e?*|--input=*|--output=*|--error=*) shift ;;
                        --) shift; break ;;
                        *) break ;;
                    esac
                done ;;
            -*) return 1 ;;
            *) [[ $1 =~ ^[a-zA-Z_][a-zA-Z_0-9]*= ]] && { shift; continue; }; break ;;
        esac
    done
    [[ $# -gt 0 ]] || return 1
    # Classify the requested basename before resolving symlinks: local Wine
    # wrappers may point to an executable with a different name.
    if proot_only "$1"; then REPLY=${1##*/}; return 0; fi
    case ${1##*/} in bash|sh|dash|zsh|fish|tmux|xterm|xfce4-terminal) return 1 ;; esac
    if [[ $1 == "$resolved_command" ]]; then target=$resolved_target
    else native_target_into "$1" 2>/dev/null || return 1; target=$REPLY; fi
    [[ $target == "$R/"* && -f $target && -x $target ]] || return 1
    case ${target##*/} in env|gpu-run|electron-run|bash|sh|dash|zsh|fish|tmux|xterm|xfce4-terminal) return 1 ;; esac
    program_name_valid "${target##*/}" || return 1
    REPLY_TARGET=$target REPLY_INDEX=$((argc - $#))
    REPLY=${target##*/}
}
native_program() { native_program_into '' '' "$@" && printf '%s\n' "$REPLY"; }

native_is_learned() {
    local learned
    [[ -r $N/proot-list ]] || return 1
    while IFS= read -r learned || [[ -n $learned ]]; do
        [[ $learned != "$1" ]] || return 0
    done < "$N/proot-list"
    return 1
}

request_proot() {
    # The caller owns this private mktemp file. Program exit codes never set it.
    if [[ -n ${DD_NATIVE_RESULT:-} ]]; then printf 'proot\n' > "$DD_NATIVE_RESULT"; fi
    return 3
}

proot_only() {
    case ${1##*/} in
        # Wine derives its library directory from its own executable identity.
        wine|wine64|wine-stable|wineserver|wineboot|winecfg|wineconsole|winetricks|hangover*|box64|box86|fex*|FEXInterpreter|FEXLoader) return 0 ;;
        apt|apt-get|apt-cache|aptitude|dpkg|dpkg-reconfigure|debconf|sudo|su|passwd|useradd|usermod|groupadd|chroot|mount|umount|systemctl|service|update-alternatives|proot-distro|droiddesk-session-bus) return 0 ;;
    esac
    return 1
}

native_decision() {
    local log=${TMPDIR:-$T}/droiddesk-native.log name=${3##*/} contents LC_ALL=C
    # One bounded line; never record arguments or control characters from a command name.
    name=${name//[^a-zA-Z0-9_.+-]/_}; name=${name:0:128}
    { [[ -d ${log%/*} ]] || mkdir -p "${log%/*}"
      if [[ -f $log ]]; then
          # Stop at the byte limit or a NUL. Plain read -N ignores NUL bytes,
          # which would let a binary/corrupted log bypass the size bound.
          if IFS= read -r -d '' -n 65537 contents < "$log"; then
              if (( ${#contents} > 65536 )); then
                  tail -c 32768 "$log" > "$log.old" && mv -f "$log.old" "$log"
              else
                  : > "$log"
              fi
          fi
      fi
      printf '%s %s %s\n' "$1" "$2" "$name" >> "$log"
    } 2>/dev/null || true
}

try_native() {
    local cmd=${1:-} reason= target= word body program= gui=0 status started launch_target=
    local stderr_log= stderr_pid= stderr_fd fatal=0
    local program_target= program_index= mirror_status
    local -a launch_args=("$@")
    local -a words=()
    if ! native_enabled; then reason=disabled
    elif ! native_ready; then reason=not-ready
    elif [[ -z $cmd ]]; then reason=no-command
    elif proot_only "$cmd"; then reason=proot-only
    else
        if [[ ${cmd##*/} == bash && ( ${2:-} == -lc || ${2:-} == -c ) ]]; then
            body=${3:-}
            read -r -a words <<< "${body//$'\n'/ }"
            for word in "${words[@]}"; do
                case $word in exec|command|env|[a-zA-Z_]*=*) continue ;; esac
                # Strip simple quoting and shell punctuation, without evaluating input.
                word=${word//[\"\']/}; word=${word%%[\;\|\&]*}
                if proot_only "$word"; then reason=proot-only; fi
                break
            done
        fi
        if [[ -z $reason ]]; then
            if native_target_into "$cmd" 2>/dev/null; then target=$REPLY
            else reason=not-found; fi
            [[ -n $reason || ( -f $target && -x $target ) ]] || reason=not-found
            [[ -n $reason || $target == "$R/"* ]] || reason=outside-rootfs
            if [[ -z $reason ]]; then
                if native_program_into "$cmd" "$target" "$@"; then
                    program=$REPLY program_target=$REPLY_TARGET program_index=$REPLY_INDEX
                fi
                if [[ -n $program ]]; then
                    if proot_only "$program"; then reason=proot-only
                    elif native_is_learned "$program"; then reason=learned; fi
                fi
            fi
        fi
    fi
    # Menu entries explicitly opt in; direct electron-run launches may also opt in by shape.
    # Both descriptors must be non-TTY, so a terminal command is never retried or learned.
    if [[ ! -t 0 && ! -t 1 && ( ${DD_NATIVE_GUI:-0} == 1 || ${cmd##*/} == electron-run ) ]]; then gui=1; fi
    if [[ -z $reason && $gui == 1 && -z $program ]]; then reason=gui-wrapper; fi
    if [[ -n $reason ]]; then native_decision proot "$reason" "${program:-$cmd}"; request_proot; return 3; fi
    # apt can add absolute library links while the desktop stays open. Refresh them now,
    # without rebuilding app binaries, so newly installed programs need no manual setup.
    if ! setup_libraries >> "${TMPDIR:-$T}/droiddesk-native-setup.log" 2>&1; then
        native_decision proot libraries "${program:-$cmd}"; request_proot; return 3
    fi
    if [[ -n $program_target ]]; then
        if electron_mirror_into "$program_target"; then
            launch_args[program_index]=$REPLY
        else
            mirror_status=$?
            case $mirror_status in
                1) ;; # Not an Electron ELF: keep the loader path (including Brave).
                3)
                    native_decision proot electron-needs-patchelf "$program"
                    if [[ $gui != 1 ]]; then
                        printf 'Pro nativní Electron aplikace spusťte: pkg install patchelf\n' >&2
                    fi
                    request_proot; return 3 ;;
                *) native_decision proot electron-mirror "$program"; request_proot; return 3 ;;
            esac
        fi
    fi
    native_decision native ready "${program:-$cmd}"
    launch_target=$target
    [[ -z $program_index || $program_index != 0 ]] || launch_target=${launch_args[0]}
    if [[ $gui != 1 ]]; then native_launch "${launch_args[@]}"; return; fi
    started=$SECONDS
    if [[ ${DD_NATIVE_GUI:-0} == 1 ]]; then
        stderr_log=$(mktemp "${TMPDIR:-$T}/droiddesk-native-stderr.XXXXXX") || { request_proot; return 3; }
        # Pass stderr through and retain only its last 16 KiB. Drain before checking.
        exec {stderr_fd}> >(tee -a /dev/stderr | tail -c 16384 > "$stderr_log")
        stderr_pid=$!
        if (native_launch "${launch_args[@]}") 2>&$stderr_fd; then status=0; else status=$?; fi
        exec {stderr_fd}>&-
        wait "$stderr_pid" || true
        if grep -aEq "Bad system call|Trace/breakpoint trap|GPU process isn.t usable|SIGSYS|Segmentation fault|cannot open shared object|Illegal instruction" "$stderr_log"; then fatal=1; fi
        rm -f "$stderr_log"
    else
        if (native_launch "${launch_args[@]}"); then status=0; else status=$?; fi
    fi
    if (( (status != 0 || fatal) && SECONDS - started < 5 )); then
        proot_list_update add "$program" || printf 'Varování: Fallback pro %s se nepodařilo uložit.\n' "$program" >&2
        native_decision proot "quick-exit-$status" "$program"
        if [[ -n ${DD_NATIVE_RESULT:-} ]]; then request_proot; return 3; fi
        # Standalone try has no caller to perform the restart. Force one proot launch.
        DD_NATIVE=0 exec "$PREFIX/bin/debian-run" "$@"
    fi
    return "$status"
}

native_launch() {
    local cmd=$1 target
    # Physical HOME also works for programs using direct syscalls (Bun). Login bash reads
    # Debian /etc/profile and ~/.profile, just like debian-run under proot.
    export HOME=$R/root
    cd "$HOME" || return 1
    if [[ $cmd == */* && $cmd != /* ]]; then
        # Relative symlinks with absolute Debian targets cannot be opened by Android.
        # Use the resolved file while retaining the requested argv0 (multicall tools).
        if [[ -n ${launch_target:-} ]]; then target=$launch_target
        else native_target_into "$cmd" || return 1; target=$REPLY; fi
        shift
        run_native /bin/bash -lc 'cd ~; exec -a "$0" "$@"' "$cmd" "$target" "$@"
    fi
    run_native /bin/bash -lc 'cd ~; exec "$@"' debian-run "$@"
}

update_path_links() {
    # Bun looks up commands (MCP servers: npx, uvx, node) with its own system calls, past
    # pathhook, and found nothing in Debian's /usr/bin (Tab S10 FE). This directory holds a
    # link to the real file for every program in Debian's PATH and goes last in Claude's
    # PATH: Bun finds the link, exec still goes through pathhook. Rebuilt when a target changes.
    python3 - "$R" "$N/path-links" <<'PY'
import fcntl, os, shutil, sys, tempfile

root, dest = sys.argv[1:]
dirs = ['/usr/local/sbin', '/usr/local/bin', '/usr/sbin', '/usr/bin', '/sbin', '/bin']

def resolve(path):
    # Like resolve_into: absolute link targets stay inside the Debian rootfs; targets that
    # already carry the physical rootfs path (pathhook writes such links) are taken as is.
    done, parts, hops = [], path.split('/'), 0
    while parts:
        part = parts.pop(0)
        if part in ('', '.'):
            continue
        if part == '..':
            if done:
                done.pop()
            continue
        current = root + '/' + '/'.join(done + [part])
        if os.path.islink(current):
            hops += 1
            if hops > 40:
                return None
            target = os.readlink(current)
            if target == root or target.startswith(root + '/'):
                target = target[len(root):] or '/'
            if target.startswith('/'):
                done = []
            parts = target.split('/') + parts
        else:
            done.append(part)
    return root + '/' + '/'.join(done)

def wanted():
    # Resolve every name on each launch (stat only): link chains outside PATH and
    # executable bits change without touching the PATH directories.
    links, seen = [], set()
    for directory in dirs:
        real_dir = resolve(directory)
        if not real_dir or not os.path.isdir(real_dir):
            continue
        for name in sorted(os.listdir(real_dir)):
            if name in seen or name.startswith('.'):
                continue
            target = resolve(directory + '/' + name)
            if target and os.path.isfile(target) and os.access(target, os.X_OK):
                seen.add(name)
                links.append((name, target))
    return links

def current_manifest():
    try:
        with open(os.path.join(dest, '.manifest'), encoding='utf-8', errors='surrogateescape') as f:
            return f.read()
    except OSError:
        return None

parent = os.path.dirname(dest)
with open(dest + '.lock', 'w') as lock:
    # Parallel launches would otherwise publish each other's half-built directory.
    fcntl.flock(lock, fcntl.LOCK_EX)
    links = wanted()
    manifest = ''.join(f'{name}\0{target}\n' for name, target in links)
    if current_manifest() == manifest:
        sys.exit(0)
    stage = tempfile.mkdtemp(prefix=os.path.basename(dest) + '.', dir=parent)
    for name, target in links:
        os.symlink(target, os.path.join(stage, name))
    with open(os.path.join(stage, '.manifest'), 'w', encoding='utf-8', errors='surrogateescape') as f:
        f.write(manifest)
    os.chmod(stage, 0o755)
    # dest is a link to the current version, swapped atomically for running processes.
    previous = os.path.join(parent, os.readlink(dest)) if os.path.islink(dest) else None
    if os.path.isdir(dest) and not os.path.islink(dest):
        shutil.rmtree(dest)
    link = stage + '.link'
    os.symlink(os.path.basename(stage), link)
    os.replace(link, dest)
    if previous and previous != stage and os.path.dirname(previous) == parent and os.path.isdir(previous):
        shutil.rmtree(previous, ignore_errors=True)
PY
}

claude_native() {
    ready
    need_python
    local candidate target home=${DD_CLAUDE_HOME:-$R/root}
    if [[ ${1:-} == --home ]]; then
        [[ $# -ge 2 ]] || fail 'Použití: droiddesk-glibc-native claude [--home ADRESÁŘ] [ARGUMENTY]'
        home=$2; shift 2
    fi
    case $home in /root|/root/*|/home|/home/*) home=$R$home ;; esac
    if [[ $home == "$R/root" ]]; then
        printf 'Varování: Nativní Claude sdílí ~/.claude s relací Claude v prootu.\n' >&2
    fi
    # Bun does file access with its own system calls, past pathhook: the built-in Read, Grep,
    # Glob and Edit tools only see real paths (Tab S10 FE). Start in the real path of the
    # project directory, like claude-tmux does under proot; DD_CLAUDE_DIR overrides it.
    local project=${DD_CLAUDE_DIR:-$R/root/projekty/Claude}
    case $project in /root|/root/*|/home|/home/*) project=$R$project ;; esac
    mkdir -p "$project" && cd "$project" || fail "Adresář projektu nejde otevřít: $project"
    # The native auto-updater installed a second 281 MB copy into the config HOME.
    local -a claude_env=(/usr/bin/env DISABLE_AUTOUPDATER=1)
    # Bun reads files past pathhook; Debian rg goes through it (Grep and Glob see Debian paths).
    [[ ! -x $R/usr/bin/rg ]] || claude_env+=(USE_BUILTIN_RIPGREP=0)
    # Read, Edit, Write and Glob still see Android paths: tell Claude where Debian is.
    set -- --append-system-prompt "This Claude Code runs natively on Android (DroidDesk). Its Read, Edit, Write and Glob tools and the built-in grep and rg shell functions bypass the Debian path mapping: absolute Debian paths (/etc, /usr, /var, /opt, /root, /home) reach Android instead. For those tools put the rootfs path in front of the Debian path, e.g. $R/etc/hosts. In the Bash tool Debian paths work; use command grep there." "$@"
    if update_path_links; then
        claude_env+=("PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:$N/path-links")
    else
        printf 'Varování: Odkazy na programy pro MCP servery se nepodařilo připravit.\n' >&2
    fi
    # Installation lookup stays in the Debian home even with an isolated config HOME.
    candidate=$R/root/.local/bin/claude
    if [[ -e $candidate || -L $candidate ]]; then
        target=$(resolve "$candidate")
        if [[ -f $target && $(head -c 4 "$target") == $'\177ELF' ]]; then
            # Bun single-file ELFs contain absolute references: never patchelf them.
            HOME=$home run_native "${claude_env[@]}" "$target" "$@"
        elif [[ -f $target ]]; then
            HOME=$home run_native "${claude_env[@]}" /usr/bin/node "$target" "$@"
        fi
    fi
    for candidate in "$R/usr/local/lib/node_modules/@anthropic-ai/claude-code/cli.js" \
                     "$R/usr/lib/node_modules/@anthropic-ai/claude-code/cli.js" \
                     "$R/root/.npm-global/lib/node_modules/@anthropic-ai/claude-code/cli.js"; do
        if [[ -f $candidate ]]; then HOME=$home run_native "${claude_env[@]}" /usr/bin/node "$candidate" "$@"; fi
    done
    fail 'Claude Code nebyl v Debianu nalezen. Nejdříve jej nainstalujte pomocí aplikace.'
}

selftest() {
    ready
    local failed=0 name
    for name in true shell python git node; do
        local -a args
        case $name in
            true) args=(/usr/bin/true) ;;
            shell) args=(/bin/sh -c 'test -f /etc/debian_version && /usr/bin/true && git --version') ;;
            python) args=(/usr/bin/python3 -c 'import ssl, locale; print(ssl.OPENSSL_VERSION); print(locale.setlocale(locale.LC_ALL, ""))') ;;
            git) args=(/usr/bin/git --version) ;;
            node) [[ -x $R/usr/bin/node ]] || { printf 'SKIP node (není nainstalován)\n'; continue; }; args=(/usr/bin/node -e 'console.log(process.version)') ;;
        esac
        if (run_native "${args[@]}"); then printf 'OK %s\n' "$name"; else printf 'FAIL %s\n' "$name"; failed=1; fi
    done
    return "$failed"
}

command=${1:-}; [[ $# == 0 ]] || shift
case $command in
    setup) setup ;;
    patch) ready; need_python; need_patchelf; [[ $# -gt 0 ]] || fail 'Použití: droiddesk-glibc-native patch PROGRAM...'; for binary in "$@"; do if [[ -d $(source_path "$binary") ]]; then mirror_app "$binary"; else patch_one "$binary"; fi; done ;;
    app) ready; need_python; need_patchelf; [[ $# == 2 ]] || fail 'Použití: droiddesk-glibc-native app ADRESÁŘ PROGRAM'; mirror_app "$@" ;;
    run) run_native "$@" ;;
    try) try_native "$@" ;;
    on|off|status) native_switch "$command" ;;
    reset) native_reset "$@" ;;
    learn) native_learn "$@" ;;
    claude) claude_native "$@" ;;
    path-links) ready; need_python; update_path_links ;;
    selftest) selftest ;;
    *) fail 'Použití: droiddesk-glibc-native {setup|on|off|status|learn NÁZEV|reset NÁZEV|--all|try PŘÍKAZ [ARGUMENTY]|patch PROGRAM...|app ADRESÁŘ PROGRAM|run PŘÍKAZ [ARGUMENTY]|claude [ARGUMENTY]|path-links|selftest}' ;;
esac
